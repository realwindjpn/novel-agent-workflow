{
  "version": "2026-08-08.body-gate-v1",
  "purpose": "SenseNova/科武素材采集信息源路由矩阵。吸收 Agent-Reach 的 channel/doctor 思路，但不安装第三方包。2026-06-21 修复：添加 domain_route_overrides，解决 anti-bot/API/RSS 域名被错误路由到 light_crawler（requests-only）的问题。2026-08-08：固化正文成功门禁——搜索摘要/空正文不得算 body success。",
  "principles": [
    "先专用通道，后通用网页，最后浏览器/人工接力",
    "discovery 只作线索，正式卡必须反查 primary/official/academic",
    "正文抓取失败必须记录 failure_tag，不得伪装成有效素材",
    "搜索摘要/snippet 只能 discovery，不得算 body_fetched / official_verified body",
    "空正文、短正文(<120去空白字符)、无 URL 条目不得自动转正式素材卡",
    "模型只做蒸馏/审卡/映射，不替代抓取",
    "anti-bot 域名（403/407）必须跳过 light/requests 直走 browser/crawl4ai",
    "API-only 域名（openalex 等）不得走 HTML 抓取，须走 anysearch_extract",
    "RSS 源必须走 rss 路由，不得走 light/html"
  ],
  "routes": {
    "official_webpage": {
      "examples": ["gov.cn", "xinhuanet.com", "people.com.cn", "cctv.com", "cnsa.gov.cn", "nasa.gov", "esa.int"],
      "fast_path": ["light", "browser", "crawl4ai"],
      "fallback": ["jina_reader", "web_extract", "official_rss_or_site_search"],
      "valid_for_card": true,
      "failure_tags": ["NO_OFFICIAL_HIT", "INDEX_OR_CHANNEL_URL", "BODY_TOO_SHORT", "CONNECTION_ERROR", "STALE_DOMESTIC_ARTICLE"]
    },
    "academic_paper": {
      "examples": ["arxiv", "pubmed", "openalex", "nature", "science", "ieee"],
      "fast_path": ["anysearch_extract", "light", "browser"],
      "fallback": ["doi_landing_page", "jina_reader", "web_extract"],
      "valid_for_card": true,
      "failure_tags": ["NO_ABSTRACT", "PAYWALL_REQUIRED", "NO_PRIMARY_SOURCE"]
    },
    "bilibili_science": {
      "examples": ["科学旅行", "B站科普视频", "BV号"],
      "fast_path": ["collect_web.py --source bili --with-subtitle", "bilibili_view_api", "player_subtitle_api"],
      "fallback": ["danmaku_or_metadata", "yt_dlp_metadata", "browser_dom", "search_title_recover_bvid"],
      "valid_for_card": false,
      "postprocess": "作为科普/discovery源；正式科武卡须反查论文/百科/官方/教材等 primary 或 educational source。",
      "failure_tags": ["BILI_COOKIE_MISSING", "NO_SUBTITLE", "API_412", "METADATA_ONLY"]
    },
    "wechat_official_account": {
      "examples": ["mp.weixin.qq.com", "公众号文章"],
      "fast_path": ["collect_web.py --source wechat", "wechat_ua_scene1"],
      "fallback": ["agent-reach/wechat idea: Exa/mcporter search+markdown", "browser_meta", "official_repost_search"],
      "valid_for_card": "depends_on_source_identity",
      "failure_tags": ["BODY_RESTRICTED_META_ONLY", "CAPTCHA_REQUIRED", "LOGIN_REQUIRED"]
    },
    "rss_feed": {
      "examples": ["NASA RSS", "ESA RSS", "Nature RSS", "SIA RSS"],
      "fast_path": ["rss"],
      "fallback": ["homepage_search", "light", "jina_reader"],
      "valid_for_card": "only_after_body_fetch",
      "failure_tags": ["RSS_NO_LINK", "RSS_STALE", "BODY_FETCH_FAIL"]
    },
    "github_repo": {
      "examples": ["GitHub项目", "开源技能", "Agent-Reach"],
      "fast_path": ["gh_api_or_github_contents_api", "README_raw"],
      "fallback": ["web_extract_github", "git_clone_tmp_readonly"],
      "valid_for_card": false,
      "postprocess": "工具/方法论进 IMA/技能 reference；不直接进科武事实库。",
      "failure_tags": ["CLONE_TIMEOUT", "README_ONLY", "SUPPLY_CHAIN_RISK"]
    },
    "x_twitter": {
      "fast_path": ["xurl_or_public_probe"],
      "fallback": ["fx/twitter mirrors", "browser_dom", "web_search_repost"],
      "valid_for_card": false,
      "postprocess": "discovery/评论养料；正式事实须反查官方源。",
      "failure_tags": ["LOGIN_REQUIRED", "RATE_LIMIT", "NO_ARTICLE_BODY"]
    },
    "weibo_xhs_reddit_v2ex": {
      "fast_path": ["platform_cli_or_public_endpoint"],
      "fallback": ["browser_dom", "search_snippet", "manual_review"],
      "valid_for_card": false,
      "postprocess": "舆情/discovery，不作 primary fact。",
      "failure_tags": ["LOGIN_REQUIRED", "ANTI_BOT", "DISCOVERY_ONLY"]
    },
    "expert_public_view": {
      "examples": ["沈逸公开文章/公开视频/访谈", "高志凯公开文章/公开视频/访谈"],
      "fast_path": ["direct_public_url_body_fetch", "official_social_or_platform_reader", "authority_repost_body_fetch"],
      "fallback": ["AnySearch/Bing discovery", "browser_dom", "manual_review"],
      "valid_for_card": "only_after_public_url_and_body_or_transcript",
      "postprocess": "生成 expert_voice_cards；P0/P1策略扰动进入 p0_p1_expert_cards；MiroFish 前必须 expert_gate_pass=true。搜索摘要只能作 discovery，不得冒充原文或专家建议。",
      "required_experts": ["沈逸", "高志凯"],
      "output_fields": ["expert_voice_cards", "p0_p1_expert_cards", "expert_gate_pass"],
      "failure_tags": [
        "EXPERT_SOURCE_NO_PRIMARY_HIT",
        "EXPERT_SOURCE_BODY_BLOCKED",
        "EXPERT_GATE_INSUFFICIENT",
        "EXPERT_SOURCE_SEARCH_SUMMARY_ONLY"
      ]
    }
  },
