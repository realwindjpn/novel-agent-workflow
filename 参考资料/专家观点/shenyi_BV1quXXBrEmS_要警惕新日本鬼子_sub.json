{"font_size": 0.4, "font_color": "#FFFFFF", "background_alpha": 0.5, "background_color": "#9C27B0", "Stroke": "none", "type": "AIsubtitle", "lang": "zh", "version": "v1.7.0.4", "body": [{"from": 0.08, "to": 2.38, "sid": 1, "location": 2, "content": "我觉得我们应该棒喝日本国吧", "music": 0.0}, {"from": 2.38, "to": 4.34, "sid": 2, "location": 2, "content": "棒喝高士早苗吧", "music": 0.0}, {"from": 4.34, "to": 6.2, "sid": 3, "location": 2, "content": "你到底想干什么", "music": 0.0}, {"from": 6.2, "to": 7.04, "sid": 4, "location": 2, "content": "为什么", "music": 0.0}, {"from": 7.04, "to": 11.18, "sid": 5, "location": 2, "content": "在你们积极推动新日本法西斯的", "music": 0.0}, {"from": 11.18, "to": 13.679, "sid": 6, "location": 2, "content": "这个错误的思潮的过程中", "music": 0.0}, {"from": 13.679, "to": 17.33, "sid": 7, "location": 2, "content": "竟然真的冒出了这种新日本鬼子啊", "music": 0.0}, {"from": 23.44, "to": 23.88, "sid": 8, "location": 2, "content": "大家好", "music": 0.0}, {"from": 25.18, "to": 26.86, "sid": 9, "location": 2, "content": "欢迎收看高谈不论", "music": 0.0}, {"from": 26.86, "to": 28.58, "sid": 10, "location": 2, "content": "今天我们聊一聊", "music": 0.0}, {"from": 28.58, "to": 34.29, "sid": 11, "location": 2, "content": "令人感到百思不可其解的一个日本的自卫队", "music": 0.0}, {"from": 34.29, "to": 35.79, "sid": 12, "location": 2, "content": "现役的军官", "music": 0.0}, {"from": 43.24, "to": 46.7, "sid": 13, "location": 2, "content": "这个怪事我给大家分析分析", "music": 0.0}, {"from": 46.7, "to": 52.28, "sid": 14, "location": 2, "content": "大家知道去年啊日本出了一个叫高市早苗的", "music": 0.0}, {"from": 52.28, "to": 56.11, "sid": 15, "location": 2, "content": "然后呢做了一大堆的啊坏事儿", "music": 0.0}, {"from": 56.11, "to": 60.2, "sid": 16, "location": 2, "content": "我们政府呢要求他收回错误的言论", "music": 0.0}, {"from": 60.2, "to": 62.22, "sid": 17, "location": 2, "content": "他到现在也没有收回啊", "music": 0.0}, {"from": 62.22, "to": 67.19, "sid": 18, "location": 2, "content": "日本政府现在还在错误的道路上越走越远啊", "music": 0.0}, {"from": 67.19, "to": 69.81, "sid": 19, "location": 2, "content": "我从一开始就给他定了个姓", "music": 0.0}, {"from": 69.81, "to": 70.21, "sid": 20, "location": 2, "content": "叫", "music": 0.0}, {"from": 70.21, "to": 72.59, "sid": 21, "location": 2, "content": "这是高市早苗事件", "music": 0.0}, {"from": 72.59, "to": 75.57, "sid": 22, "location": 2, "content": "高市早苗事件的核心的核心", "music": 0.0}, {"from": 75.57, "to": 79.9, "sid": 23, "location": 2, "content": "就是日本想彻底的推翻1945年", "music": 0.0}, {"from": 79.9, "to": 82.9, "sid": 24, "location": 2, "content": "日本无条件向我们中国投降", "music": 0.0}, {"from": 82.9, "to": 85.28, "sid": 25, "location": 2, "content": "和向其他的盟国投降", "music": 0.0}, {"from": 85.28, "to": 87.43, "sid": 26, "location": 2, "content": "日本的这种阴暗面哦", "music": 0.0}, {"from": 87.43, "to": 91.55, "sid": 27, "location": 2, "content": "不愿意跟日本法西斯的英魂切断联系", "music": 0.0}, {"from": 91.55, "to": 93.87, "sid": 28, "location": 2, "content": "这可是根深蒂固的", "music": 0.0}, {"from": 93.87, "to": 96.14, "sid": 29, "location": 2, "content": "这不是一天两天的事儿啊", "music": 0.0}, {"from": 96.14, "to": 100.53, "sid": 30, "location": 2, "content": "所以当我说日本有一个叫高市早苗现象", "music": 0.0}, {"from": 100.53, "to": 102.87, "sid": 31, "location": 2, "content": "高士扫描事件的时候", "music": 0.0}, {"from": 102.87, "to": 107.87, "sid": 32, "location": 2, "content": "我们一定要看清楚他心里到底是在想什么", "music": 0.0}, {"from": 107.87, "to": 112.33, "sid": 33, "location": 2, "content": "我们不仅要求他和这些日本势力啊", "music": 0.0}, {"from": 112.33, "to": 114.17, "sid": 34, "location": 2, "content": "收回错误的言论", "music": 0.0}, {"from": 114.17, "to": 120.03, "sid": 35, "location": 2, "content": "我们一定要他们哦放弃做这种伤天害理的事", "music": 0.0}, {"from": 120.03, "to": 121.23, "sid": 36, "location": 2, "content": "所以你听我说", "music": 0.0}, {"from": 121.23, "to": 124.73, "sid": 37, "location": 2, "content": "日本现在非常非常的危险了", "music": 0.0}, {"from": 124.73, "to": 128.639, "sid": 38, "location": 2, "content": "他要在错误的道路上越走越远", "music": 0.0}, {"from": 128.639, "to": 131.439, "sid": 39, "location": 2, "content": "我觉得是在这样的一个大背景下", "music": 0.0}, {"from": 131.439, "to": 135.89, "sid": 40, "location": 2, "content": "才会出现了这么一个大家根本没有想到", "music": 0.0}, {"from": 135.89, "to": 139.09, "sid": 41, "location": 2, "content": "而且我们绝对不能够原谅的事儿", "music": 0.0}, {"from": 142.31, "to": 146.18, "sid": 42, "location": 2, "content": "和我们在日本的大使馆的特殊性呢", "music": 0.0}, {"from": 149.14, "to": 151.74, "sid": 43, "location": 2, "content": "我们享受主权啊", "music": 0.0}, {"from": 151.74, "to": 154.6, "sid": 44, "location": 2, "content": "我们享受外交豁免了", "music": 0.0}, {"from": 154.6, "to": 156.31, "sid": 45, "location": 2, "content": "你一个日本人", "music": 0.0}, {"from": 156.31, "to": 160.01, "sid": 46, "location": 2, "content": "怎么能够硬闯我们中国驻日本国的大使馆呢", "music": 0.0}, {"from": 160.01, "to": 163.98, "sid": 47, "location": 2, "content": "更何况你还是一个现役的自卫队的军官呢", "music": 0.0}, {"from": 163.98, "to": 166.28, "sid": 48, "location": 2, "content": "另外一个你还得有刀具", "music": 0.0}, {"from": 166.28, "to": 167.769, "sid": 49, "location": 2, "content": "那还得了", "music": 0.0}, {"from": 167.769, "to": 169.94, "sid": 50, "location": 2, "content": "我跟大家说啊", "music": 0.0}, {"from": 170.18, "to": 174.74, "sid": 51, "location": 2, "content": "其实从去年日本冒出了这么一个高市", "music": 0.0}, {"from": 174.74, "to": 176.45, "sid": 52, "location": 2, "content": "早苗事件以后", "music": 0.0}, {"from": 176.45, "to": 179.57, "sid": 53, "location": 2, "content": "我在国内几乎是独一无二的", "music": 0.0}, {"from": 179.57, "to": 182.79, "sid": 54, "location": 2, "content": "我喊打倒新日本鬼子", "music": 0.0}, {"from": 182.79, "to": 183.77, "sid": 55, "location": 2, "content": "有人问我", "music": 0.0}, {"from": 183.77, "to": 185.81, "sid": 56, "location": 2, "content": "谁是新日本鬼子啊", "music": 0.0}, {"from": 185.81, "to": 192.4, "sid": 57, "location": 2, "content": "我觉得这个少壮派的日本自卫队现役的军官", "music": 0.0}, {"from": 192.4, "to": 196.46, "sid": 58, "location": 2, "content": "带着刀硬闯中国驻日本国大使馆", "music": 0.0}, {"from": 196.46, "to": 198.9, "sid": 59, "location": 2, "content": "试图要杀害我们的外交官", "music": 0.0}, {"from": 198.9, "to": 201.22, "sid": 60, "location": 2, "content": "甚至杀害我们的大使", "music": 0.0}, {"from": 201.22, "to": 203.56, "sid": 61, "location": 2, "content": "这就是一个新日本鬼子", "music": 0.0}, {"from": 203.56, "to": 206.47, "sid": 62, "location": 2, "content": "我觉得我们一定要同仇敌忾啊", "music": 0.0}, {"from": 206.47, "to": 208.95, "sid": 63, "location": 2, "content": "对日本人表明我们的立场", "music": 0.0}, {"from": 208.95, "to": 210.81, "sid": 64, "location": 2, "content": "打倒新日本鬼子啊", "music": 0.0}, {"from": 210.81, "to": 212.93, "sid": 65, "location": 2, "content": "打倒新日本法西斯啊", "music": 0.0}, {"from": 212.93, "to": 216.61, "sid": 66, "location": 2, "content": "我们怎么能够容忍这样的事发生了", "music": 0.0}, {"from": 216.61, "to": 218.21, "sid": 67, "location": 2, "content": "而且大家听我说", "music": 0.0}, {"from": 218.21, "to": 222.199, "sid": 68, "location": 2, "content": "现在世界上有200个国家左右吧", "music": 0.0}, {"from": 222.199, "to": 227.17, "sid": 69, "location": 2, "content": "你知道只有一个国家向我们中国无条件投降", "music": 0.0}, {"from": 227.17, "to": 228.11, "sid": 70, "location": 2, "content": "那是谁", "music": 0.0}, {"from": 228.11, "to": 229.25, "sid": 71, "location": 2, "content": "那就是日本", "music": 0.0}, {"from": 229.25, "to": 231.69, "sid": 72, "location": 2, "content": "那有些人说中国日本", "music": 0.0}, {"from": 231.69, "to": 235.56, "sid": 73, "location": 2, "content": "中国日本就好像两个国家完全平起平坐的错", "music": 0.0}, {"from": 235.56, "to": 240.15, "sid": 74, "location": 2, "content": "日本1945年向我们中国无条件投降了", "music": 0.0}, {"from": 240.15, "to": 242.07, "sid": 75, "location": 2, "content": "中国是胜利国", "music": 0.0}, {"from": 242.07, "to": 243.98, "sid": 76, "location": 2, "content": "日本是战败国", "music": 0.0}, {"from": 243.98, "to": 245.06, "sid": 77, "location": 2, "content": "这一点的话", "music": 0.0}, {"from": 245.06, "to": 250.55, "sid": 78, "location": 2, "content": "就界定了中国与日本之间的关系是不相等的", "music": 0.0}, {"from": 250.55, "to": 254.09, "sid": 79, "location": 2, "content": "他们已经无条件地向我们中国投降了", "music": 0.0}, {"from": 254.09, "to": 256.64, "sid": 80, "location": 2, "content": "他们没有任何理由", "music": 0.0}, {"from": 256.64, "to": 258.58, "sid": 81, "location": 2, "content": "没有任何的根据", "music": 0.0}, {"from": 258.58, "to": 260.14, "sid": 82, "location": 2, "content": "要重新武装", "music": 0.0}, {"from": 260.14, "to": 263.47, "sid": 83, "location": 2, "content": "要重新构成对我们中国的威胁", "music": 0.0}, {"from": 263.47, "to": 268.75, "sid": 84, "location": 2, "content": "甚至扬言要对我们发动军事攻击甚至战争", "music": 0.0}, {"from": 268.75, "to": 272.44, "sid": 85, "location": 2, "content": "所以啊我觉得我们应该棒喝日本国吧", "music": 0.0}, {"from": 272.44, "to": 274.38, "sid": 86, "location": 2, "content": "棒喝高士早苗吧", "music": 0.0}, {"from": 274.38, "to": 276.24, "sid": 87, "location": 2, "content": "你到底想干什么", "music": 0.0}, {"from": 276.24, "to": 277.1, "sid": 88, "location": 2, "content": "为什么", "music": 0.0}, {"from": 277.1, "to": 281.22, "sid": 89, "location": 2, "content": "在你们积极推动新日本法西斯的", "music": 0.0}, {"from": 281.22, "to": 283.7, "sid": 90, "location": 2, "content": "这个错误的思潮的过程中", "music": 0.0}, {"from": 283.7, "to": 287.65, "sid": 91, "location": 2, "content": "竟然真的冒出了这种新日本鬼子啊", "music": 0.0}, {"from": 287.65, "to": 290.91, "sid": 92, "location": 2, "content": "另外一个我们要看一看这个高氏早苗", "music": 0.0}, {"from": 290.91, "to": 293.44, "sid": 93, "location": 2, "content": "到底在打算做什么呢", "music": 0.0}, {"from": 293.44, "to": 297.52, "sid": 94, "location": 2, "content": "一方面哎呀这个高士早苗在美国啊", "music": 0.0}, {"from": 297.52, "to": 298.52, "sid": 95, "location": 2, "content": "特朗普面前", "music": 0.0}, {"from": 298.52, "to": 303.94, "sid": 96, "location": 2, "content": "那绝对是一个叫禅眉下作自取其辱", "music": 0.0}, {"from": 303.94, "to": 307.66, "sid": 97, "location": 2, "content": "另外他也不仅是自取其自己的辱啊", "music": 0.0}, {"from": 310.92, "to": 313.84, "sid": 98, "location": 2, "content": "日本国家的脸呢", "music": 0.0}, {"from": 313.84, "to": 317.53, "sid": 99, "location": 2, "content": "你说你怎么能够想象一个人哦", "music": 0.0}, {"from": 317.53, "to": 320.39, "sid": 100, "location": 2, "content": "在光天化日之下", "music": 0.0}, {"from": 320.39, "to": 323.05, "sid": 101, "location": 2, "content": "在全世界的关注下", "music": 0.0}, {"from": 323.05, "to": 325.17, "sid": 102, "location": 2, "content": "如此的谄媚", "music": 0.0}, {"from": 325.17, "to": 327.21, "sid": 103, "location": 2, "content": "如此的下作", "music": 0.0}, {"from": 327.21, "to": 330.19, "sid": 104, "location": 2, "content": "如此的下流哦", "music": 0.0}, {"from": 330.19, "to": 331.35, "sid": 105, "location": 2, "content": "他想干什么", "music": 0.0}, {"from": 331.35, "to": 333.039, "sid": 106, "location": 2, "content": "我给大家分析分析", "music": 0.0}, {"from": 333.039, "to": 337.499, "sid": 107, "location": 2, "content": "这个高士早苗及其它所代表的这种错误的", "music": 0.0}, {"from": 337.499, "to": 340.53, "sid": 108, "location": 2, "content": "危险的思潮或者势力", "music": 0.0}, {"from": 340.53, "to": 346.57, "sid": 109, "location": 2, "content": "他现在是想在台湾海峡挑出一个事端", "music": 0.0}, {"from": 346.57, "to": 352.13, "sid": 110, "location": 2, "content": "然后呢把美国绑在日本的反华仇华", "music": 0.0}, {"from": 352.13, "to": 354.3, "sid": 111, "location": 2, "content": "敌华的战车上", "music": 0.0}, {"from": 354.3, "to": 356.1, "sid": 112, "location": 2, "content": "因为日本人自己知道", "music": 0.0}, {"from": 356.1, "to": 357.82, "sid": 113, "location": 2, "content": "靠他单枪匹马", "music": 0.0}, {"from": 357.82, "to": 361.66, "sid": 114, "location": 2, "content": "他如果要跟中国发动战争发动冲突的话", "music": 0.0}, {"from": 361.66, "to": 366.85, "sid": 115, "location": 2, "content": "第一个他没有稳抄胜券的可能啊", "music": 0.0}, {"from": 366.85, "to": 369.55, "sid": 116, "location": 2, "content": "另外一个他又不死这条心", "music": 0.0}, {"from": 369.55, "to": 370.63, "sid": 117, "location": 2, "content": "那他怎么办呢", "music": 0.0}, {"from": 370.63, "to": 373.43, "sid": 118, "location": 2, "content": "他就必须拉着美国人哦", "music": 0.0}, {"from": 373.43, "to": 374.82, "sid": 119, "location": 2, "content": "跟我们斗", "music": 0.0}, {"from": 374.82, "to": 376.24, "sid": 120, "location": 2, "content": "这还得了", "music": 0.0}, {"from": 376.24, "to": 379.36, "sid": 121, "location": 2, "content": "所以我觉得啊我们一定要清醒", "music": 0.0}, {"from": 379.36, "to": 381.62, "sid": 122, "location": 2, "content": "一定要严加防范", "music": 0.0}, {"from": 381.62, "to": 383.7, "sid": 123, "location": 2, "content": "一定要棒喝日本啊", "music": 0.0}, {"from": 383.7, "to": 385.09, "sid": 124, "location": 2, "content": "因为真的", "music": 0.0}, {"from": 385.09, "to": 392.16, "sid": 125, "location": 2, "content": "日本在高斯早苗事件这样的错误的流毒影响下", "music": 0.0}, {"from": 392.16, "to": 395.0, "sid": 126, "location": 2, "content": "真的有新日本鬼子了", "music": 0.0}, {"from": 395.0, "to": 398.36, "sid": 127, "location": 2, "content": "这个少壮派的日本自卫队现役军官啊", "music": 0.0}, {"from": 398.36, "to": 402.71, "sid": 128, "location": 2, "content": "带着刀具硬闯中国驻日本的大使馆", "music": 0.0}, {"from": 402.71, "to": 408.12, "sid": 129, "location": 2, "content": "绝对不可能是单独的孤立的一件事", "music": 0.0}, {"from": 408.12, "to": 415.1, "sid": 130, "location": 2, "content": "它反映的就是日本国内一种非常危险的倾向", "music": 0.0}, {"from": 415.1, "to": 420.12, "sid": 131, "location": 2, "content": "而这种倾向它不是从真空里冒出来的", "music": 0.0}, {"from": 420.12, "to": 423.78, "sid": 132, "location": 2, "content": "大家知道在日本无条件投降之前啊", "music": 0.0}, {"from": 423.78, "to": 427.49, "sid": 133, "location": 2, "content": "就是1945年8月日本无条件投降之前", "music": 0.0}, {"from": 427.49, "to": 430.07, "sid": 134, "location": 2, "content": "哎呦日本几十年啊", "music": 0.0}, {"from": 430.07, "to": 432.51, "sid": 135, "location": 2, "content": "这个少壮派的军官", "music": 0.0}, {"from": 432.51, "to": 436.75, "sid": 136, "location": 2, "content": "可是日本法西斯的一个主要的组成部分啊", "music": 0.0}, {"from": 436.75, "to": 442.189, "sid": 137, "location": 2, "content": "比如说他竟然这个哦用暴力杀日本的首相", "music": 0.0}, {"from": 443.229, "to": 445.409, "sid": 138, "location": 2, "content": "如果他们认为这个日本的首相啊", "music": 0.0}, {"from": 445.409, "to": 448.569, "sid": 139, "location": 2, "content": "呃不怎么愿意积极地推动所谓的军国主义的", "music": 0.0}, {"from": 448.569, "to": 449.509, "sid": 140, "location": 2, "content": "错误的路线", "music": 0.0}, {"from": 449.509, "to": 453.69, "sid": 141, "location": 2, "content": "他们杀日本军队里边的高级军官呢", "music": 0.0}, {"from": 453.69, "to": 456.73, "sid": 142, "location": 2, "content": "他们搞成小团队一定要推动", "music": 0.0}, {"from": 456.73, "to": 460.52, "sid": 143, "location": 2, "content": "比如说新法西斯的各种各样的侵略行径", "music": 0.0}, {"from": 461.88, "to": 465.62, "sid": 144, "location": 2, "content": "到了日本快走投无路的时候", "music": 0.0}, {"from": 465.62, "to": 470.439, "sid": 145, "location": 2, "content": "这个日本军官的少壮派还拒绝投降是吧", "music": 0.0}, {"from": 470.439, "to": 473.53, "sid": 146, "location": 2, "content": "威胁比如说玉石俱焚呐", "music": 0.0}, {"from": 473.53, "to": 476.05, "sid": 147, "location": 2, "content": "哎呀1亿日本人一役兵", "music": 0.0}, {"from": 476.05, "to": 479.97, "sid": 148, "location": 2, "content": "甚至说你美军胆敢在日本本岛登陆", "music": 0.0}, {"from": 479.97, "to": 481.98, "sid": 149, "location": 2, "content": "我们就跟你拼到底", "music": 0.0}, {"from": 481.98, "to": 484.2, "sid": 150, "location": 2, "content": "这就是这一次啊", "music": 0.0}, {"from": 489.46, "to": 494.85, "sid": 151, "location": 2, "content": "日本自卫队现役军官的来龙去脉", "music": 0.0}, {"from": 495.17, "to": 496.53, "sid": 152, "location": 2, "content": "他不是孤立的", "music": 0.0}, {"from": 496.53, "to": 501.19, "sid": 153, "location": 2, "content": "它不是从真空里边突然之间蹦出来的一个事儿", "music": 0.0}, {"from": 501.19, "to": 503.25, "sid": 154, "location": 2, "content": "他是有历史的", "music": 0.0}, {"from": 503.25, "to": 504.89, "sid": 155, "location": 2, "content": "远远的", "music": 0.0}, {"from": 504.89, "to": 506.93, "sid": 156, "location": 2, "content": "这就充分的表明", "music": 0.0}, {"from": 506.93, "to": 508.59, "sid": 157, "location": 2, "content": "日本作为一个国家", "music": 0.0}, {"from": 508.59, "to": 512.33, "sid": 158, "location": 2, "content": "根本没有切断跟过去的日本", "music": 0.0}, {"from": 512.33, "to": 516.96, "sid": 159, "location": 2, "content": "法西斯或者他的英魂之间的关联", "music": 0.0}, {"from": 516.96, "to": 518.96, "sid": 160, "location": 2, "content": "所以从这个角度上来说的话", "music": 0.0}, {"from": 518.96, "to": 520.98, "sid": 161, "location": 2, "content": "我们应该高度重视", "music": 0.0}, {"from": 520.98, "to": 526.259, "sid": 162, "location": 2, "content": "日本国内所产生的这种新日本法西斯的势力", "music": 0.0}, {"from": 526.259, "to": 530.479, "sid": 163, "location": 2, "content": "他冒出来的这些新日本鬼子的现象", "music": 0.0}, {"from": 530.479, "to": 532.639, "sid": 164, "location": 2, "content": "我们要采取主动吧", "music": 0.0}, {"from": 532.639, "to": 536.5, "sid": 165, "location": 2, "content": "我最近老是听有人说啊", "music": 0.0}, {"from": 536.5, "to": 542.27, "sid": 166, "location": 2, "content": "说哎这个我们都强调中日要世世代代友好下去", "music": 0.0}, {"from": 542.27, "to": 543.07, "sid": 167, "location": 2, "content": "对呀", "music": 0.0}, {"from": 543.07, "to": 545.83, "sid": 168, "location": 2, "content": "中日一定要世世代代友好下去啊", "music": 0.0}, {"from": 545.83, "to": 549.17, "sid": 169, "location": 2, "content": "但是中日世世代代友好下去", "music": 0.0}, {"from": 549.17, "to": 551.49, "sid": 170, "location": 2, "content": "有一个先决条件", "music": 0.0}, {"from": 551.49, "to": 555.41, "sid": 171, "location": 2, "content": "那就是日本不能再出新日本鬼子", "music": 0.0}, {"from": 555.41, "to": 558.79, "sid": 172, "location": 2, "content": "日本不能再搞新日本法西斯", "music": 0.0}, {"from": 558.79, "to": 562.4, "sid": 173, "location": 2, "content": "日本不能再搞新日本军国主义啊", "music": 0.0}, {"from": 562.4, "to": 564.32, "sid": 174, "location": 2, "content": "不然的话你想中国", "music": 0.0}, {"from": 564.32, "to": 567.65, "sid": 175, "location": 2, "content": "日本怎么可能世世代代友好下去呢", "music": 0.0}, {"from": 567.65, "to": 570.07, "sid": 176, "location": 2, "content": "所以从这个角度上来说的话", "music": 0.0}, {"from": 570.07, "to": 572.81, "sid": 177, "location": 2, "content": "我甚至呼吁我们国内应该严防", "music": 0.0}, {"from": 572.81, "to": 576.06, "sid": 178, "location": 2, "content": "我们国内对日的绥靖主义", "music": 0.0}, {"from": 576.06, "to": 578.1, "sid": 179, "location": 2, "content": "一定要严防啊", "music": 0.0}, {"from": 578.1, "to": 580.26, "sid": 180, "location": 2, "content": "我们自己要站得稳呐", "music": 0.0}, {"from": 580.26, "to": 581.46, "sid": 181, "location": 2, "content": "看得准呐", "music": 0.0}, {"from": 581.46, "to": 584.98, "sid": 182, "location": 2, "content": "另外该出手的时候必须要出手", "music": 0.0}, {"from": 584.98, "to": 589.53, "sid": 183, "location": 2, "content": "这么做不是为了防止或者阻拦", "music": 0.0}, {"from": 589.53, "to": 592.5, "sid": 184, "location": 2, "content": "中日两国世世代代友好下去", "music": 0.0}, {"from": 592.5, "to": 597.96, "sid": 185, "location": 2, "content": "这样做是为中日两国实现世世代代友好", "music": 0.0}, {"from": 597.96, "to": 601.46, "sid": 186, "location": 2, "content": "电定更扎实的基础", "music": 0.0}, {"from": 601.46, "to": 604.64, "sid": 187, "location": 2, "content": "所以我希望越来越多的啊", "music": 0.0}, {"from": 604.64, "to": 607.34, "sid": 188, "location": 2, "content": "朋友们能够跟我一样哦", "music": 0.0}, {"from": 607.34, "to": 612.12, "sid": 189, "location": 2, "content": "看到日本现在国内出现的这些危险的现象", "music": 0.0}, {"from": 612.12, "to": 614.36, "sid": 190, "location": 2, "content": "他是非常危险的", "music": 0.0}, {"from": 614.36, "to": 616.88, "sid": 191, "location": 2, "content": "我们一定要表明态度", "music": 0.0}, {"from": 616.88, "to": 619.76, "sid": 192, "location": 2, "content": "然后呢采取有效的措施啊", "music": 0.0}, {"from": 619.76, "to": 621.42, "sid": 193, "location": 2, "content": "予以对付", "music": 0.0}, {"from": 621.42, "to": 624.0, "sid": 194, "location": 2, "content": "对于日本现在出现的这种事", "music": 0.0}, {"from": 624.0, "to": 625.89, "sid": 195, "location": 2, "content": "我们不能应付", "music": 0.0}, {"from": 625.89, "to": 631.66, "sid": 196, "location": 2, "content": "我们一定要对付彻底的棒喝日本", "music": 0.0}, {"from": 631.66, "to": 637.08, "sid": 197, "location": 2, "content": "坚决反对日本搞新的日本法西斯", "music": 0.0}, {"from": 637.08, "to": 639.94, "sid": 198, "location": 2, "content": "搞新的日本军国主义", "music": 0.0}, {"from": 639.94, "to": 643.099, "sid": 199, "location": 2, "content": "坚决打倒新日本鬼子", "music": 0.0}, {"from": 643.099, "to": 644.719, "sid": 200, "location": 2, "content": "今天就聊到这儿", "music": 0.0}, {"from": 644.719, "to": 647.019, "sid": 201, "location": 2, "content": "感谢大家收看高谈", "music": 0.0}, {"from": 647.019, "to": 649.98, "sid": 202, "location": 2, "content": "不论我们下次再聊", "music": 0.0}]}