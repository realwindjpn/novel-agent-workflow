{"font_size": 0.4, "font_color": "#FFFFFF", "background_alpha": 0.5, "background_color": "#9C27B0", "Stroke": "none", "type": "AIsubtitle", "lang": "zh", "version": "v1.7.0.4", "body": [{"from": 0.04, "to": 4.969, "sid": 1, "location": 2, "content": "如果说要根本的改变联合国现在的情况", "music": 0.0}, {"from": 4.969, "to": 7.429, "sid": 2, "location": 2, "content": "尤其是安理会啊", "music": 0.0}, {"from": 7.429, "to": 8.669, "sid": 3, "location": 2, "content": "五大常任理事国", "music": 0.0}, {"from": 8.669, "to": 11.66, "sid": 4, "location": 2, "content": "各有一票否决权的这样的一个现状的话", "music": 0.0}, {"from": 11.66, "to": 12.76, "sid": 5, "location": 2, "content": "我担心啊", "music": 0.0}, {"from": 12.76, "to": 15.6, "sid": 6, "location": 2, "content": "非得先打一场世界大战不可", "music": 0.0}, {"from": 15.6, "to": 16.48, "sid": 7, "location": 2, "content": "不然的话呢", "music": 0.0}, {"from": 16.48, "to": 19.8, "sid": 8, "location": 2, "content": "你很难去从根本上改变联合国", "music": 0.0}, {"from": 19.8, "to": 22.18, "sid": 9, "location": 2, "content": "现在的这种权力分配", "music": 0.0}, {"from": 22.18, "to": 23.88, "sid": 10, "location": 2, "content": "大家有很多的不满", "music": 0.0}, {"from": 23.88, "to": 27.61, "sid": 11, "location": 2, "content": "但是联合国实际上实现了他的初衷", "music": 0.0}, {"from": 36.3, "to": 37.06, "sid": 12, "location": 2, "content": "大家好", "music": 0.0}, {"from": 38.22, "to": 44.36, "sid": 13, "location": 2, "content": "我现在在美国纽约曼哈顿联合国大厦的前面呃", "music": 0.0}, {"from": 44.36, "to": 45.7, "sid": 14, "location": 2, "content": "我想跟大家谈一谈", "music": 0.0}, {"from": 45.7, "to": 50.06, "sid": 15, "location": 2, "content": "我怎么看待联合国现在的情况啊", "music": 0.0}, {"from": 50.06, "to": 54.93, "sid": 16, "location": 2, "content": "最近几年大家国际上对于联合国的低效率", "music": 0.0}, {"from": 54.93, "to": 58.19, "sid": 17, "location": 2, "content": "然后呢无法发挥关键作用啊", "music": 0.0}, {"from": 58.19, "to": 59.71, "sid": 18, "location": 2, "content": "怨声载道", "music": 0.0}, {"from": 59.71, "to": 61.95, "sid": 19, "location": 2, "content": "而且呢很多国家都呼吁啊", "music": 0.0}, {"from": 61.95, "to": 65.42, "sid": 20, "location": 2, "content": "要对联合国进行根本性的改革", "music": 0.0}, {"from": 65.42, "to": 70.259, "sid": 21, "location": 2, "content": "主要是涉及到联合国安理会的投票权的问题啊", "music": 0.0}, {"from": 70.259, "to": 71.619, "sid": 22, "location": 2, "content": "我想谈一谈", "music": 0.0}, {"from": 71.619, "to": 76.64, "sid": 23, "location": 2, "content": "实际上1945年联合国成立并正式运作以来", "music": 0.0}, {"from": 76.64, "to": 79.1, "sid": 24, "location": 2, "content": "联合国最大的任务是", "music": 0.0}, {"from": 79.1, "to": 82.31, "sid": 25, "location": 2, "content": "要避免发生第三次世界大战", "music": 0.0}, {"from": 86.73, "to": 90.91, "sid": 26, "location": 2, "content": "就是以联合国安理会五大常任理事国", "music": 0.0}, {"from": 90.91, "to": 93.33, "sid": 27, "location": 2, "content": "各有一票否决权", "music": 0.0}, {"from": 93.33, "to": 97.39, "sid": 28, "location": 2, "content": "这样的一种互相制衡的体制", "music": 0.0}, {"from": 97.39, "to": 99.21, "sid": 29, "location": 2, "content": "从这个角度上来说", "music": 0.0}, {"from": 99.21, "to": 101.289, "sid": 30, "location": 2, "content": "实际上联合国很成功啊", "music": 0.0}, {"from": 101.289, "to": 102.969, "sid": 31, "location": 2, "content": "因为从1945年以来", "music": 0.0}, {"from": 106.849, "to": 109.95, "sid": 32, "location": 2, "content": "所以虽然联合国有各种各样的问题", "music": 0.0}, {"from": 109.95, "to": 111.83, "sid": 33, "location": 2, "content": "大家有很多的不满", "music": 0.0}, {"from": 111.83, "to": 115.51, "sid": 34, "location": 2, "content": "但是联合国实际上实现了他的初衷", "music": 0.0}, {"from": 119.94, "to": 120.68, "sid": 35, "location": 2, "content": "当然了", "music": 0.0}, {"from": 120.68, "to": 122.3, "sid": 36, "location": 2, "content": "联合国现在效率很低", "music": 0.0}, {"from": 122.3, "to": 123.08, "sid": 37, "location": 2, "content": "什么事呢", "music": 0.0}, {"from": 123.08, "to": 124.59, "sid": 38, "location": 2, "content": "他都无所作为", "music": 0.0}, {"from": 124.59, "to": 126.13, "sid": 39, "location": 2, "content": "原因之一是什么呢", "music": 0.0}, {"from": 126.13, "to": 128.72, "sid": 40, "location": 2, "content": "因为五大常任理事国", "music": 0.0}, {"from": 128.72, "to": 132.16, "sid": 41, "location": 2, "content": "经常是因为他们各自见解不一样", "music": 0.0}, {"from": 132.16, "to": 132.94, "sid": 42, "location": 2, "content": "想法不一样", "music": 0.0}, {"from": 132.94, "to": 133.9, "sid": 43, "location": 2, "content": "出发点不一样", "music": 0.0}, {"from": 133.9, "to": 134.99, "sid": 44, "location": 2, "content": "算盘不一样", "music": 0.0}, {"from": 134.99, "to": 138.31, "sid": 45, "location": 2, "content": "很难就现在世界上面临的重大问题啊", "music": 0.0}, {"from": 138.31, "to": 140.18, "sid": 46, "location": 2, "content": "达成一致意见", "music": 0.0}, {"from": 140.18, "to": 145.06, "sid": 47, "location": 2, "content": "所以呢联合国的问题也是确实存在的", "music": 0.0}, {"from": 145.06, "to": 147.76, "sid": 48, "location": 2, "content": "但是我想说一条", "music": 0.0}, {"from": 147.76, "to": 152.9, "sid": 49, "location": 2, "content": "如果说要根本的改变联合国现在的情况", "music": 0.0}, {"from": 152.9, "to": 155.36, "sid": 50, "location": 2, "content": "尤其是安理会啊", "music": 0.0}, {"from": 155.36, "to": 156.6, "sid": 51, "location": 2, "content": "五大常任理事国", "music": 0.0}, {"from": 156.6, "to": 159.579, "sid": 52, "location": 2, "content": "各有一票否决权的这样的一个现状的话", "music": 0.0}, {"from": 159.579, "to": 160.699, "sid": 53, "location": 2, "content": "我担心啊", "music": 0.0}, {"from": 160.699, "to": 163.53, "sid": 54, "location": 2, "content": "非得先打一场世界大战不可", "music": 0.0}, {"from": 163.53, "to": 164.41, "sid": 55, "location": 2, "content": "不然的话呢", "music": 0.0}, {"from": 164.41, "to": 167.73, "sid": 56, "location": 2, "content": "你很难去从根本上改变联合国", "music": 0.0}, {"from": 167.73, "to": 170.23, "sid": 57, "location": 2, "content": "现在的这种权力分配", "music": 0.0}, {"from": 174.889, "to": 179.409, "sid": 58, "location": 2, "content": "就不是为了一个单极的单边的国际社会而存", "music": 0.0}, {"from": 179.409, "to": 180.88, "sid": 59, "location": 2, "content": "立出国", "music": 0.0}, {"from": 182.44, "to": 183.78, "sid": 60, "location": 2, "content": "而是要确保", "music": 0.0}, {"from": 183.78, "to": 186.02, "sid": 61, "location": 2, "content": "没有一个国家能够", "music": 0.0}, {"from": 186.02, "to": 190.4, "sid": 62, "location": 2, "content": "把自己的意志强加在联合国安理会之上", "music": 0.0}, {"from": 190.4, "to": 195.81, "sid": 63, "location": 2, "content": "或者他能够啊把自己的利益强加在全世界之上", "music": 0.0}, {"from": 195.81, "to": 197.57, "sid": 64, "location": 2, "content": "所以从这个角度上来说", "music": 0.0}, {"from": 197.57, "to": 199.24, "sid": 65, "location": 2, "content": "你比如说这两天啊", "music": 0.0}, {"from": 199.24, "to": 203.7, "sid": 66, "location": 2, "content": "这个美国和以色列对发对伊朗发动的侵略战争", "music": 0.0}, {"from": 203.7, "to": 205.82, "sid": 67, "location": 2, "content": "已经打了一个多月了", "music": 0.0}, {"from": 205.82, "to": 206.54, "sid": 68, "location": 2, "content": "然后呢", "music": 0.0}, {"from": 206.54, "to": 208.12, "sid": 69, "location": 2, "content": "美国现在突然宣布啊", "music": 0.0}, {"from": 208.12, "to": 212.84, "sid": 70, "location": 2, "content": "他要对这个霍尔木斯海峡的部分的封锁", "music": 0.0}, {"from": 212.84, "to": 215.23, "sid": 71, "location": 2, "content": "进行海军封锁", "music": 0.0}, {"from": 215.23, "to": 215.63, "sid": 72, "location": 2, "content": "唉", "music": 0.0}, {"from": 215.63, "to": 216.71, "sid": 73, "location": 2, "content": "这个本身的话", "music": 0.0}, {"from": 216.71, "to": 219.459, "sid": 74, "location": 2, "content": "是没有得到联合国安理会的批准的", "music": 0.0}, {"from": 219.459, "to": 222.099, "sid": 75, "location": 2, "content": "它实际上是不符合国际法的", "music": 0.0}, {"from": 222.099, "to": 225.35, "sid": 76, "location": 2, "content": "美国怎么能够这样动辄用自己的军力", "music": 0.0}, {"from": 225.35, "to": 229.05, "sid": 77, "location": 2, "content": "就在一个公海上进行海军封锁呢", "music": 0.0}, {"from": 229.05, "to": 233.19, "sid": 78, "location": 2, "content": "所以我觉得世界上很多人还是自有公道", "music": 0.0}, {"from": 233.19, "to": 234.86, "sid": 79, "location": 2, "content": "心里都有一把秤啊", "music": 0.0}, {"from": 234.86, "to": 238.14, "sid": 80, "location": 2, "content": "美国现在做的在海上进行封锁", "music": 0.0}, {"from": 238.14, "to": 239.98, "sid": 81, "location": 2, "content": "是不符合国际法的", "music": 0.0}, {"from": 239.98, "to": 242.55, "sid": 82, "location": 2, "content": "是没有联合国安理会的批准", "music": 0.0}, {"from": 242.55, "to": 247.03, "sid": 83, "location": 2, "content": "所以我觉得他这么做本身是失道寡助", "music": 0.0}, {"from": 247.03, "to": 250.81, "sid": 84, "location": 2, "content": "最后呢只会使得美国众叛亲离", "music": 0.0}, {"from": 250.81, "to": 253.25, "sid": 85, "location": 2, "content": "我这次到美国来啊", "music": 0.0}, {"from": 253.25, "to": 255.59, "sid": 86, "location": 2, "content": "了解到一个令人震惊的事", "music": 0.0}, {"from": 255.59, "to": 261.009, "sid": 87, "location": 2, "content": "说现在日本啊高氏早苗政府在美国上跳下窜", "music": 0.0}, {"from": 264.609, "to": 267.73, "sid": 88, "location": 2, "content": "他的目的呢就是要从根本上啊", "music": 0.0}, {"from": 267.73, "to": 271.21, "sid": 89, "location": 2, "content": "提高和改善日本在国际上的地位", "music": 0.0}, {"from": 271.21, "to": 274.67, "sid": 90, "location": 2, "content": "他想成为东亚地区乃至于亚洲地区", "music": 0.0}, {"from": 274.67, "to": 276.73, "sid": 91, "location": 2, "content": "最有影响力的国家", "music": 0.0}, {"from": 276.73, "to": 277.61, "sid": 92, "location": 2, "content": "他过去呢", "music": 0.0}, {"from": 277.61, "to": 280.13, "sid": 93, "location": 2, "content": "一直想成为联合国安理会的常任理事国", "music": 0.0}, {"from": 280.13, "to": 281.21, "sid": 94, "location": 2, "content": "但是我说了", "music": 0.0}, {"from": 281.21, "to": 284.83, "sid": 95, "location": 2, "content": "如果日本不把中国当做朋友的话", "music": 0.0}, {"from": 284.83, "to": 288.07, "sid": 96, "location": 2, "content": "他怎么可能成为联合国安理会的常任理事国呢", "music": 0.0}, {"from": 288.07, "to": 292.79, "sid": 97, "location": 2, "content": "因为我们中国作为常任理事国有一票否决权呐", "music": 0.0}, {"from": 292.79, "to": 295.93, "sid": 98, "location": 2, "content": "所以现在看来日本还有别的野心啊", "music": 0.0}, {"from": 295.93, "to": 298.169, "sid": 99, "location": 2, "content": "他想说服美国", "music": 0.0}, {"from": 298.169, "to": 303.22, "sid": 100, "location": 2, "content": "让日本在东亚地区扮演越来越重要的作用", "music": 0.0}, {"from": 303.22, "to": 305.3, "sid": 101, "location": 2, "content": "不仅是在经济上", "music": 0.0}, {"from": 305.3, "to": 306.14, "sid": 102, "location": 2, "content": "当然现在经济", "music": 0.0}, {"from": 306.14, "to": 308.9, "sid": 103, "location": 2, "content": "它已经永远的落后于中国的经济规模啊", "music": 0.0}, {"from": 308.9, "to": 311.96, "sid": 104, "location": 2, "content": "中国经济规模现在已是日本的五倍以上了", "music": 0.0}, {"from": 311.96, "to": 316.46, "sid": 105, "location": 2, "content": "所以他还在什么地方能够在东亚地区称王称霸", "music": 0.0}, {"from": 316.46, "to": 320.56, "sid": 106, "location": 2, "content": "甚至说我想啊变成东亚地区的第一个领导人呢", "music": 0.0}, {"from": 320.56, "to": 324.3, "sid": 107, "location": 2, "content": "他竟然说他要在政治上和军事上", "music": 0.0}, {"from": 324.3, "to": 326.429, "sid": 108, "location": 2, "content": "成为东亚的领袖", "music": 0.0}, {"from": 326.429, "to": 330.689, "sid": 109, "location": 2, "content": "那这一点是不是日本呢不自量力呀", "music": 0.0}, {"from": 330.689, "to": 334.84, "sid": 110, "location": 2, "content": "还是日本想和美国啊串通在一起", "music": 0.0}, {"from": 334.84, "to": 335.76, "sid": 111, "location": 2, "content": "然后呢", "music": 0.0}, {"from": 335.76, "to": 339.24, "sid": 112, "location": 2, "content": "彻底的改变整个东亚地区的权力分", "music": 0.0}, {"from": 339.24, "to": 342.22, "sid": 113, "location": 2, "content": "配和地缘政治的事实", "music": 0.0}, {"from": 342.22, "to": 343.82, "sid": 114, "location": 2, "content": "从这一点上的话", "music": 0.0}, {"from": 343.82, "to": 347.06, "sid": 115, "location": 2, "content": "我觉得我们中国也应该很明确的跟日本说", "music": 0.0}, {"from": 347.06, "to": 349.77, "sid": 116, "location": 2, "content": "你如果要违反1945年", "music": 0.0}, {"from": 349.77, "to": 354.21, "sid": 117, "location": 2, "content": "无条件向中国和其他盟国作出无条件投降", "music": 0.0}, {"from": 354.21, "to": 355.36, "sid": 118, "location": 2, "content": "所做的承诺", "music": 0.0}, {"from": 357.22, "to": 360.83, "sid": 119, "location": 2, "content": "如果还要对中国和其他国家构成威胁的话", "music": 0.0}, {"from": 360.83, "to": 363.05, "sid": 120, "location": 2, "content": "那中国坚决不会答应", "music": 0.0}, {"from": 363.05, "to": 363.71, "sid": 121, "location": 2, "content": "另外一个", "music": 0.0}, {"from": 363.71, "to": 365.809, "sid": 122, "location": 2, "content": "我觉得美国人也不会答应啊", "music": 0.0}, {"from": 365.809, "to": 368.409, "sid": 123, "location": 2, "content": "因为我到美国来见到每一个美国人", "music": 0.0}, {"from": 368.409, "to": 372.44, "sid": 124, "location": 2, "content": "我跟都跟他们提醒不要忘记珍珠港啊", "music": 0.0}, {"from": 372.44, "to": 374.76, "sid": 125, "location": 2, "content": "所以美国人也不应该忘记珍珠港", "music": 0.0}, {"from": 374.76, "to": 376.44, "sid": 126, "location": 2, "content": "美国人不应该啊", "music": 0.0}, {"from": 376.44, "to": 380.02, "sid": 127, "location": 2, "content": "把日本在第二次世界大战啊", "music": 0.0}, {"from": 380.02, "to": 381.1, "sid": 128, "location": 2, "content": "对于我们中国来说", "music": 0.0}, {"from": 381.1, "to": 384.78, "sid": 129, "location": 2, "content": "从1931年到1945年期间", "music": 0.0}, {"from": 384.78, "to": 386.76, "sid": 130, "location": 2, "content": "所犯下的滔天罪行啊", "music": 0.0}, {"from": 386.76, "to": 388.12, "sid": 131, "location": 2, "content": "就是一笔勾销", "music": 0.0}, {"from": 388.12, "to": 389.22, "sid": 132, "location": 2, "content": "这是不可能的", "music": 0.0}, {"from": 389.22, "to": 392.47, "sid": 133, "location": 2, "content": "我们一定要记住日本犯下的滔天罪行", "music": 0.0}, {"from": 392.47, "to": 395.51, "sid": 134, "location": 2, "content": "而且呢中国和美国应该有机会", "music": 0.0}, {"from": 395.51, "to": 400.13, "sid": 135, "location": 2, "content": "有可能要进行合作来制止日本", "music": 0.0}, {"from": 400.13, "to": 402.01, "sid": 136, "location": 2, "content": "推翻第二次世界大战", "music": 0.0}, {"from": 402.01, "to": 404.37, "sid": 137, "location": 2, "content": "日本无条件投降这一铁案", "music": 0.0}, {"from": 404.37, "to": 407.31, "sid": 138, "location": 2, "content": "甚至要在东亚地区", "music": 0.0}, {"from": 407.31, "to": 411.86, "sid": 139, "location": 2, "content": "对像中国这样的战胜国再构成威胁", "music": 0.0}]}