{"font_size": 0.4, "font_color": "#FFFFFF", "background_alpha": 0.5, "background_color": "#9C27B0", "Stroke": "none", "type": "AIsubtitle", "lang": "zh", "version": "v1.7.0.4", "body": [{"from": 0.08, "to": 3.8, "sid": 1, "location": 2, "content": "中国与美国继续保持啊对话", "music": 0.0}, {"from": 3.8, "to": 5.22, "sid": 2, "location": 2, "content": "保持磋商", "music": 0.0}, {"from": 5.22, "to": 8.37, "sid": 3, "location": 2, "content": "继续再就关税问题进行谈判", "music": 0.0}, {"from": 8.37, "to": 10.87, "sid": 4, "location": 2, "content": "这一点本身是非常积极的", "music": 0.0}, {"from": 10.87, "to": 14.25, "sid": 5, "location": 2, "content": "同时呢巴黎的谈判也表明啊", "music": 0.0}, {"from": 14.25, "to": 15.27, "sid": 6, "location": 2, "content": "中国和美国", "music": 0.0}, {"from": 15.27, "to": 18.63, "sid": 7, "location": 2, "content": "继续在为特朗普总统对中国进行", "music": 0.0}, {"from": 20.64, "to": 24.12, "sid": 8, "location": 2, "content": "我们能不能哦设置几个议题哦", "music": 0.0}, {"from": 24.12, "to": 33.92, "sid": 9, "location": 2, "content": "然后再中美之间我们采取主动的", "music": 0.026143790564882686}, {"from": 34.04, "to": 34.88, "sid": 10, "location": 2, "content": "大家好", "music": 0.0}, {"from": 34.88, "to": 36.36, "sid": 11, "location": 2, "content": "欢迎收看高谈", "music": 0.0}, {"from": 39.989, "to": 40.909, "sid": 12, "location": 2, "content": "此时此刻", "music": 0.0}, {"from": 40.909, "to": 44.5, "sid": 13, "location": 2, "content": "中美高层啊正在巴黎聚首", "music": 0.0}, {"from": 44.5, "to": 48.79, "sid": 14, "location": 2, "content": "进行中美之间的关税问题的谈判", "music": 0.0}, {"from": 48.79, "to": 50.85, "sid": 15, "location": 2, "content": "这一点呢有几个信号", "music": 0.0}, {"from": 50.85, "to": 51.51, "sid": 16, "location": 2, "content": "一个", "music": 0.0}, {"from": 51.51, "to": 53.39, "sid": 17, "location": 2, "content": "即便是美国最高法院", "music": 0.0}, {"from": 53.39, "to": 56.84, "sid": 18, "location": 2, "content": "于2020年2月6日宣布啊", "music": 0.0}, {"from": 56.84, "to": 61.96, "sid": 19, "location": 2, "content": "特朗普政府于2025年4月2号向全世界", "music": 0.0}, {"from": 61.96, "to": 65.16, "sid": 20, "location": 2, "content": "包括向我们中国发动的贸易战啊", "music": 0.0}, {"from": 65.16, "to": 66.88, "sid": 21, "location": 2, "content": "关税战是非法的", "music": 0.0}, {"from": 67.94, "to": 72.43, "sid": 22, "location": 2, "content": "但是中国与美国继续保持啊对话", "music": 0.0}, {"from": 72.43, "to": 73.87, "sid": 23, "location": 2, "content": "保持磋商", "music": 0.0}, {"from": 73.87, "to": 77.009, "sid": 24, "location": 2, "content": "继续再就关税问题进行谈判", "music": 0.0}, {"from": 77.009, "to": 79.509, "sid": 25, "location": 2, "content": "这一点本身是非常积极的", "music": 0.0}, {"from": 79.509, "to": 82.889, "sid": 26, "location": 2, "content": "同时呢巴黎的谈判也表明啊", "music": 0.0}, {"from": 82.889, "to": 87.829, "sid": 27, "location": 2, "content": "中国和美国继续在为特朗普总统原计划3月底", "music": 0.0}, {"from": 91.97, "to": 96.1, "sid": 28, "location": 2, "content": "我想谈一下我的两个个人的观察呃", "music": 0.0}, {"from": 96.1, "to": 98.02, "sid": 29, "location": 2, "content": "我这是个人的意见", "music": 0.0}, {"from": 98.02, "to": 102.78, "sid": 30, "location": 2, "content": "最终肯定是以政府有关部门的立场和宣布", "music": 0.0}, {"from": 102.78, "to": 104.12, "sid": 31, "location": 2, "content": "为准呢", "music": 0.0}, {"from": 104.12, "to": 108.439, "sid": 32, "location": 2, "content": "第一个我觉得从2018年开始", "music": 0.0}, {"from": 108.439, "to": 109.759, "sid": 33, "location": 2, "content": "特龙普1.0和", "music": 0.0}, {"from": 109.759, "to": 113.62, "sid": 34, "location": 2, "content": "后来拜登和后来特朗普2.0啊", "music": 0.0}, {"from": 113.62, "to": 118.12, "sid": 35, "location": 2, "content": "持续不断的对我们中国发动这个关税战", "music": 0.0}, {"from": 118.12, "to": 121.04, "sid": 36, "location": 2, "content": "我从一开始就说这个关税战", "music": 0.0}, {"from": 121.04, "to": 122.98, "sid": 37, "location": 2, "content": "我们应该给它取个名字", "music": 0.0}, {"from": 122.98, "to": 126.59, "sid": 38, "location": 2, "content": "叫美国发动的反华关税战", "music": 0.0}, {"from": 126.59, "to": 130.05, "sid": 39, "location": 2, "content": "那我们不能够说这是中美关税战", "music": 0.0}, {"from": 130.05, "to": 133.65, "sid": 40, "location": 2, "content": "正如同我们不能把1931年到1945年", "music": 0.0}, {"from": 133.65, "to": 138.539, "sid": 41, "location": 2, "content": "我们中国人民进行的这场战争叫做中日战争错", "music": 0.0}, {"from": 138.539, "to": 140.38, "sid": 42, "location": 2, "content": "不能叫中日战争啊", "music": 0.0}, {"from": 140.38, "to": 142.56, "sid": 43, "location": 2, "content": "我们正确的名字只有一个", "music": 0.0}, {"from": 142.56, "to": 145.28, "sid": 44, "location": 2, "content": "那就是中国人民抗日战争", "music": 0.0}, {"from": 145.28, "to": 147.48, "sid": 45, "location": 2, "content": "我们也不能把1950年打到", "music": 0.0}, {"from": 147.48, "to": 149.35, "sid": 46, "location": 2, "content": "1953年的那场战争", "music": 0.0}, {"from": 149.35, "to": 152.59, "sid": 47, "location": 2, "content": "像美国人说的叫朝鲜战争错", "music": 0.0}, {"from": 152.59, "to": 155.07, "sid": 48, "location": 2, "content": "我们不能把它叫做朝鲜战争", "music": 0.0}, {"from": 155.07, "to": 157.48, "sid": 49, "location": 2, "content": "我们有一个正确的名称啊", "music": 0.0}, {"from": 157.48, "to": 159.52, "sid": 50, "location": 2, "content": "叫抗美援朝", "music": 0.0}, {"from": 159.52, "to": 160.72, "sid": 51, "location": 2, "content": "保家卫国", "music": 0.0}, {"from": 160.72, "to": 162.579, "sid": 52, "location": 2, "content": "所以我觉得第一个啊", "music": 0.0}, {"from": 162.579, "to": 165.499, "sid": 53, "location": 2, "content": "我愿意跟全国各地的朋友们提个建议", "music": 0.0}, {"from": 165.499, "to": 169.839, "sid": 54, "location": 2, "content": "我们不能再把美国发动的这个关税战啊", "music": 0.0}, {"from": 169.839, "to": 173.079, "sid": 55, "location": 2, "content": "针对我们中国的叫做是中美关税战", "music": 0.0}, {"from": 173.079, "to": 174.379, "sid": 56, "location": 2, "content": "我给它取了个名字", "music": 0.0}, {"from": 174.379, "to": 177.63, "sid": 57, "location": 2, "content": "叫美国发动的反华关税战", "music": 0.0}, {"from": 177.63, "to": 179.23, "sid": 58, "location": 2, "content": "那你可能会说了", "music": 0.0}, {"from": 179.23, "to": 181.03, "sid": 59, "location": 2, "content": "2025年4月2号以后", "music": 0.0}, {"from": 181.03, "to": 183.27, "sid": 60, "location": 2, "content": "美国也对世界上200多个国家和地区", "music": 0.0}, {"from": 183.27, "to": 184.49, "sid": 61, "location": 2, "content": "发动关税战啊", "music": 0.0}, {"from": 184.49, "to": 186.01, "sid": 62, "location": 2, "content": "我也给它取了个名字", "music": 0.0}, {"from": 186.01, "to": 189.04, "sid": 63, "location": 2, "content": "叫美国发动的反人类关税战啊", "music": 0.0}, {"from": 189.04, "to": 192.9, "sid": 64, "location": 2, "content": "那么现在美国最高法院啊已经通过终审判决", "music": 0.0}, {"from": 192.9, "to": 193.7, "sid": 65, "location": 2, "content": "宣布", "music": 0.0}, {"from": 193.7, "to": 198.32, "sid": 66, "location": 2, "content": "特朗普2025年4月2号所发动的关税战", "music": 0.0}, {"from": 198.32, "to": 199.34, "sid": 67, "location": 2, "content": "是非法的", "music": 0.0}, {"from": 200.46, "to": 202.02, "sid": 68, "location": 2, "content": "这就验明了", "music": 0.0}, {"from": 205.4, "to": 209.62, "sid": 69, "location": 2, "content": "所以我们首先要拿捏美国人搞的是什么事儿", "music": 0.0}, {"from": 209.62, "to": 213.94, "sid": 70, "location": 2, "content": "另外一个我从去年四季度就开始在北京", "music": 0.0}, {"from": 213.94, "to": 217.21, "sid": 71, "location": 2, "content": "在其他地方跟有关部门汇报嗯", "music": 0.0}, {"from": 217.21, "to": 219.99, "sid": 72, "location": 2, "content": "我说美国人急着要跟我们谈关税", "music": 0.0}, {"from": 219.99, "to": 222.05, "sid": 73, "location": 2, "content": "我们是不是可以缓一缓呢", "music": 0.0}, {"from": 222.05, "to": 223.8, "sid": 74, "location": 2, "content": "我当时是这么建议的", "music": 0.0}, {"from": 223.8, "to": 225.44, "sid": 75, "location": 2, "content": "我们可以跟美国人说嘛", "music": 0.0}, {"from": 225.44, "to": 226.48, "sid": 76, "location": 2, "content": "嗨美国啊", "music": 0.0}, {"from": 229.14, "to": 233.54, "sid": 77, "location": 2, "content": "你现在已经被上诉法院判决是违法的", "music": 0.0}, {"from": 235.88, "to": 237.96, "sid": 78, "location": 2, "content": "那你呢又气急败坏的", "music": 0.0}, {"from": 237.96, "to": 240.73, "sid": 79, "location": 2, "content": "已经向美国最高法院提出上诉了", "music": 0.0}, {"from": 240.73, "to": 242.41, "sid": 80, "location": 2, "content": "那我们能不能缓一缓", "music": 0.0}, {"from": 242.41, "to": 244.13, "sid": 81, "location": 2, "content": "先别着急谈嘛", "music": 0.0}, {"from": 244.13, "to": 246.33, "sid": 82, "location": 2, "content": "我们等到美国最高法院", "music": 0.0}, {"from": 246.33, "to": 251.47, "sid": 83, "location": 2, "content": "就你的上诉作出终审判决以后再谈也不晚呢", "music": 0.0}, {"from": 251.47, "to": 255.09, "sid": 84, "location": 2, "content": "自从2月6号美国最高法院作出终审判决以后", "music": 0.0}, {"from": 258.11, "to": 260.06, "sid": 85, "location": 2, "content": "世界各国有些国家", "music": 0.0}, {"from": 260.06, "to": 264.65, "sid": 86, "location": 2, "content": "你不是已经跟我们签了这个啊关税条约了嘛", "music": 0.0}, {"from": 264.65, "to": 265.83, "sid": 87, "location": 2, "content": "关税协议了嘛", "music": 0.0}, {"from": 265.83, "to": 267.17, "sid": 88, "location": 2, "content": "你不能悔改", "music": 0.0}, {"from": 267.17, "to": 268.01, "sid": 89, "location": 2, "content": "你不能够", "music": 0.0}, {"from": 268.01, "to": 270.89, "sid": 90, "location": 2, "content": "因为说美国最高法院已经宣判我们是非法的", "music": 0.0}, {"from": 271.69, "to": 272.77, "sid": 91, "location": 2, "content": "你就要更改", "music": 0.0}, {"from": 272.77, "to": 273.51, "sid": 92, "location": 2, "content": "没门儿", "music": 0.0}, {"from": 273.51, "to": 275.04, "sid": 93, "location": 2, "content": "你不能改哎呀", "music": 0.0}, {"from": 275.04, "to": 276.12, "sid": 94, "location": 2, "content": "所以你想想看呢", "music": 0.0}, {"from": 276.12, "to": 279.08, "sid": 95, "location": 2, "content": "如果这些国家当时还没有跟美国人", "music": 0.0}, {"from": 279.08, "to": 280.28, "sid": 96, "location": 2, "content": "签这个合同呢", "music": 0.0}, {"from": 280.28, "to": 282.56, "sid": 97, "location": 2, "content": "岂不是他们现在处境更好啊", "music": 0.0}, {"from": 282.56, "to": 286.0, "sid": 98, "location": 2, "content": "但是我觉得我们是不是应该可以考虑", "music": 0.0}, {"from": 286.0, "to": 287.46, "sid": 99, "location": 2, "content": "采取主动啊", "music": 0.0}, {"from": 287.46, "to": 290.02, "sid": 100, "location": 2, "content": "因为从2018年到现在", "music": 0.0}, {"from": 290.02, "to": 291.86, "sid": 101, "location": 2, "content": "一晃8年过去了", "music": 0.0}, {"from": 291.86, "to": 294.02, "sid": 102, "location": 2, "content": "每次都是美国出牌", "music": 0.0}, {"from": 294.02, "to": 296.26, "sid": 103, "location": 2, "content": "每次都是美国哦", "music": 0.0}, {"from": 296.26, "to": 298.0, "sid": 104, "location": 2, "content": "这个抢占时机", "music": 0.0}, {"from": 298.0, "to": 299.21, "sid": 105, "location": 2, "content": "抢占主动", "music": 0.0}, {"from": 299.21, "to": 301.71, "sid": 106, "location": 2, "content": "我们总是在被动应战", "music": 0.0}, {"from": 301.71, "to": 303.17, "sid": 107, "location": 2, "content": "那当然了", "music": 0.0}, {"from": 303.17, "to": 305.69, "sid": 108, "location": 2, "content": "过去我们的打法有点生疏", "music": 0.0}, {"from": 305.69, "to": 307.33, "sid": 109, "location": 2, "content": "现在打法有点熟了", "music": 0.0}, {"from": 307.33, "to": 309.23, "sid": 110, "location": 2, "content": "那我一个希望是什么呢", "music": 0.0}, {"from": 309.23, "to": 312.89, "sid": 111, "location": 2, "content": "我们能不能综合方方面面", "music": 0.0}, {"from": 312.89, "to": 315.57, "sid": 112, "location": 2, "content": "坚决地捍卫我们中国的利益", "music": 0.0}, {"from": 315.57, "to": 318.25, "sid": 113, "location": 2, "content": "坚决地捍卫自由贸易啊", "music": 0.0}, {"from": 318.25, "to": 321.74, "sid": 114, "location": 2, "content": "另外一个不要老是被美国人出的牌", "music": 0.0}, {"from": 322.02, "to": 324.8, "sid": 115, "location": 2, "content": "变成我们只能够回答他的问题啊", "music": 0.0}, {"from": 324.8, "to": 327.16, "sid": 116, "location": 2, "content": "我们能不能给他提几个问题", "music": 0.0}, {"from": 327.16, "to": 330.67, "sid": 117, "location": 2, "content": "我们能不能哦设置几个议题哦", "music": 0.0}, {"from": 330.67, "to": 334.64, "sid": 118, "location": 2, "content": "然后再中美之间我们采取主动呢", "music": 0.0}, {"from": 334.64, "to": 337.46, "sid": 119, "location": 2, "content": "我们能不能抓住他的鼻子啊", "music": 0.0}, {"from": 337.46, "to": 340.69, "sid": 120, "location": 2, "content": "不要被他老是抓着我们的鼻子啊", "music": 0.0}, {"from": 340.69, "to": 342.93, "sid": 121, "location": 2, "content": "所以我们的任务很重啊", "music": 0.0}, {"from": 342.93, "to": 345.91, "sid": 122, "location": 2, "content": "不仅仅是要跟美国保持这个对话", "music": 0.0}, {"from": 345.91, "to": 347.62, "sid": 123, "location": 2, "content": "谈判的这个渠道啊", "music": 0.0}, {"from": 347.62, "to": 351.42, "sid": 124, "location": 2, "content": "而且我们是要考虑到我们要积极", "music": 0.0}, {"from": 351.42, "to": 352.18, "sid": 125, "location": 2, "content": "我们要主动", "music": 0.0}, {"from": 352.18, "to": 353.38, "sid": 126, "location": 2, "content": "我们要对付他", "music": 0.0}, {"from": 353.38, "to": 355.1, "sid": 127, "location": 2, "content": "而不仅仅是应付他", "music": 0.0}, {"from": 355.1, "to": 358.59, "sid": 128, "location": 2, "content": "这里边呢有很多的可以琢磨的事", "music": 0.0}, {"from": 358.59, "to": 359.83, "sid": 129, "location": 2, "content": "由于时间的关系", "music": 0.0}, {"from": 359.83, "to": 361.21, "sid": 130, "location": 2, "content": "我也来不及啊", "music": 0.0}, {"from": 361.21, "to": 362.53, "sid": 131, "location": 2, "content": "一一展开", "music": 0.0}, {"from": 362.53, "to": 364.57, "sid": 132, "location": 2, "content": "我从2018年开始", "music": 0.0}, {"from": 364.57, "to": 368.39, "sid": 133, "location": 2, "content": "通过国内可靠的途径一直提一个建议啊", "music": 0.0}, {"from": 368.39, "to": 369.83, "sid": 134, "location": 2, "content": "今天没有时间展开谈", "music": 0.0}, {"from": 369.83, "to": 371.95, "sid": 135, "location": 2, "content": "但是我把题目告诉你", "music": 0.0}, {"from": 371.95, "to": 372.91, "sid": 136, "location": 2, "content": "我提出来", "music": 0.0}, {"from": 372.91, "to": 374.9, "sid": 137, "location": 2, "content": "我们能不能给美国出一道题", "music": 0.0}, {"from": 374.9, "to": 378.42, "sid": 138, "location": 2, "content": "首先呢是深入的分析特朗普心理学", "music": 0.0}, {"from": 378.42, "to": 380.68, "sid": 139, "location": 2, "content": "另外一个我们给他出一道题", "music": 0.0}, {"from": 380.68, "to": 382.85, "sid": 140, "location": 2, "content": "中美对等零关税", "music": 0.0}, {"from": 387.33, "to": 390.07, "sid": 141, "location": 2, "content": "在中美关税问题上", "music": 0.0}, {"from": 390.07, "to": 392.14, "sid": 142, "location": 2, "content": "贸易关系问题上", "music": 0.0}, {"from": 392.14, "to": 395.38, "sid": 143, "location": 2, "content": "我们要采取一次主动", "music": 0.0}, {"from": 395.38, "to": 397.9, "sid": 144, "location": 2, "content": "我们要吃透特朗普的心理学", "music": 0.0}, {"from": 397.9, "to": 402.3, "sid": 145, "location": 2, "content": "我们要吃透美国政府现在到底是外强中干", "music": 0.0}, {"from": 402.3, "to": 405.19, "sid": 146, "location": 2, "content": "还是他现在已经打完牌了", "music": 0.0}, {"from": 405.19, "to": 408.66, "sid": 147, "location": 2, "content": "还是他现在在做别的考虑", "music": 0.0}, {"from": 408.66, "to": 411.12, "sid": 148, "location": 2, "content": "然后我们怎么能够积极主动", "music": 0.0}, {"from": 411.12, "to": 413.74, "sid": 149, "location": 2, "content": "我们能不能给他设置一个题目", "music": 0.0}, {"from": 413.74, "to": 416.959, "sid": 150, "location": 2, "content": "我们能不能拉住他的鼻子", "music": 0.0}, {"from": 416.959, "to": 420.75, "sid": 151, "location": 2, "content": "我们能不能给他提出一个建议呢", "music": 0.0}, {"from": 420.75, "to": 422.77, "sid": 152, "location": 2, "content": "我觉得是有可能的", "music": 0.0}, {"from": 422.77, "to": 425.87, "sid": 153, "location": 2, "content": "总之啊当我看到中国", "music": 0.0}, {"from": 425.87, "to": 428.36, "sid": 154, "location": 2, "content": "美国相应的领导人在巴黎", "music": 0.0}, {"from": 428.36, "to": 431.58, "sid": 155, "location": 2, "content": "正在进行中美关税问题的谈判", "music": 0.0}, {"from": 431.58, "to": 434.5, "sid": 156, "location": 2, "content": "一方面希望能够弹出一个所以然来", "music": 0.0}, {"from": 434.5, "to": 436.98, "sid": 157, "location": 2, "content": "另外一个呢我们要坚定立场啊", "music": 0.0}, {"from": 436.98, "to": 438.22, "sid": 158, "location": 2, "content": "我们要采取主动啊", "music": 0.0}, {"from": 438.22, "to": 438.94, "sid": 159, "location": 2, "content": "我们要对付", "music": 0.0}, {"from": 438.94, "to": 440.33, "sid": 160, "location": 2, "content": "我们不能应付啊", "music": 0.0}, {"from": 440.33, "to": 441.87, "sid": 161, "location": 2, "content": "今天就聊到这", "music": 0.0}, {"from": 441.87, "to": 443.49, "sid": 162, "location": 2, "content": "感谢大家收看高谈", "music": 0.0}, {"from": 443.49, "to": 446.6, "sid": 163, "location": 2, "content": "不论我们下次再聊", "music": 0.0}]}