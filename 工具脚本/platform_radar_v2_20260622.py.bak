62|def is_non_article_url(url: str) -> bool:
63|    u = (url or '').strip().lower()
64|    if not u:
65|        return True
66|    return any(re.search(p, u) for p in NON_ARTICLE_URL_PATTERNS)
67|
68|
69|def evidence_is_body(text: str) -> bool:
70|    t = re.sub(r'\s+', ' ', text or '').strip()
71|    if len(t) < 80:
72|        return False
73|    return bool(re.search(r'[。！？；：，,.;:]', t))
74|
75|
76|def sha12(s: str) -> str:
77|    return hashlib.sha256(s.encode()).hexdigest()[:12]
78|
79|
80|def now_iso() -> str:
81|    return datetime.datetime.now().isoformat(timespec='seconds')
82|
83|
84|def run_cmd(cmd: list[str], timeout: int = 30) -> tuple[int, str, str]:
85|    try:
86|        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
87|        return p.returncode, p.stdout, p.stderr
88|    except subprocess.TimeoutExpired:
89|        return -1, '', 'TIMEOUT'
90|    except Exception as e:
91|        return -2, '', repr(e)
92|
93|
94|def score_item(account: str, platform: str, hit: dict) -> int:
95|    text = (hit.get('title', '') + ' ' + hit.get('body', '') + ' ' + hit.get('url', '')).lower()
96|    s = 0
97|    if account.lower() in text:
98|        s += 3
99|    if platform in hit.get('url', ''):
100|        s += 1
101|    if any(k in text for k in SIGNAL_KW):
102|        s += 2
103|    if any(t in text for t in NOISE_TERMS):
104|        s -= 5
105|    return s
