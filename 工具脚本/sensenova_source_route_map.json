  "auto_route_fix": {
    "_doc": "collect_web.py auto_route() 应增加的域名感知逻辑。当 auto_route 返回 'light' 时，应先检查域名是否在 anti_bot_domains 列表中，是则返回 'browser'。",
    "anti_bot_domains": [
      "spacex.com", "defense.gov", "nih.gov", "consilium.europa.eu",
      "openai.com", "state.gov", "g7.canada.ca", "canada.ca",
      "baidu.com", "sohu.com", "ifeng.com", "sina.com", "163.com",
      "qq.com", "toutiao.com", "36kr.com", "huxiu.com"
    ],
    "api_only_domains": [
      "openalex.org", "rss.arxiv.org"
    ],
    "rss_domains": [
      "rss.arxiv.org", "status.anthropic.com"
    ],
    "recommended_auto_route_logic": "1) RSS keyword/domain → 'rss'; 2) openalex → 'anysearch_extract'; 3) anti_bot_domain → 'browser'; 4) wechat/bili/weibo → platform-specific; 5) default → 'light'"
  },
  "route_matrix_fix": {
    "_doc": "pipeline runner COLLECT_WEB_ROUTE_MATRIX 的修复建议。当前 known_url=['auto','light','browser','crawl4ai'] 中 auto 内部已走 light，light 步骤冗余。且 auto 返回≥100字节的错误页 HTML 会被误判为成功，阻止升级到 browser/crawl4ai。",
    "old_known_url": ["auto", "light", "browser", "crawl4ai"],
    "new_known_url": ["light", "browser", "crawl4ai"],
    "rationale": "移除 auto（auto→light_crawler 等效于 light），避免冗余调用。light 失败后直接升级到 browser，再用 crawl4ai 兜底。",
    "success_threshold_fix": "collect_body_via_route_matrix() 中的 len(body.strip()) >= 100 阈值过低。错误页 HTML/导航 chrome 通常 200-500 字符。建议：(1) 对 anti_bot 域名跳过 light 直走 browser；(2) 对 light 返回的 body 增加内容质量检查（非纯链接/导航）；(3) 或提高阈值至 300（与 MIN_VALID_CONTENT_BODY_CHARS 一致）。"
  },
  "doctor_checks": [
    "check command existence: yt-dlp, gh, python collectors",
    "check cookies: /root/.hermes/bilibili_cookies.txt when B站字幕 required",
    "check env: TAVILY_API_KEY for article_search fallback",
    "check sample fetch: one official webpage, one RSS, one BVID if available, one WeChat url if provided",
    "report channel as OK/WARN/FAIL with next action",
    "check anti_bot_domains: verify browser route available (light_crawler browser mode or crawl4ai-skill)",
    "check domain_route_overrides: verify each override domain maps to an installed collector"
  ]
}
