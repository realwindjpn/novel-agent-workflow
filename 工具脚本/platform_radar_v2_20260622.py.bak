168|def discover_ddgs(query: str, max_results: int = 3, timeout: int = 8) -> list[dict]:
169|    """ddgs fallback — 从进程内直接调用，不spawn子进程。"""
170|    try:
171|        from ddgs import DDGS
172|        hits = []
173|        with DDGS(timeout=timeout) as d:
174|            for r in d.text(query, max_results=max_results):
175|                hits.append({
176|                    'title': r.get('title', ''),
177|                    'url': r.get('href') or r.get('url', ''),
178|                    'body': r.get('body', ''),
179|                })
180|        return hits
181|    except Exception:
182|        return []
