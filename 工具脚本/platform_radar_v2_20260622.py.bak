248|def discover_for_account(account: dict, platform: str, timeout_sec: int, limit_per_platform: int = 3) -> list[dict]:
249|    """对单个account+platform，多路由发现URL。"""
250|    name = account['name']
251|    kws = account.get('keywords', [])[:2]
252|    # 清理query：去重复词、特殊字符
253|    kw_str = ' '.join(dict.fromkeys(kws))  # 去重保序
254|    site_map = {
255|        'wechat': 'mp.weixin.qq.com',
256|        'bilibili': 'bilibili.com',
257|        'weibo': 'weibo.com',
258|        'zhihu': 'zhihu.com',
259|    }
260|    site = site_map.get(platform, '')
261|    base_q = f'site:{site} {name} {kw_str} {TODAY[:4]}' if site else f'{name} {kw_str} {TODAY[:4]}'
262|    base_q = re.sub(r'[/／]', ' ', base_q).strip()  # 去斜杠
263|    base_q = re.sub(r'\s+', ' ', base_q)  # 合并空格
264|
265|    all_hits = []
266|    seen_urls = set()
267|
268|    def _add(hits: list[dict], route: str):
269|        for h in hits:
270|            u = h.get('url', '')
271|            if u and u not in seen_urls:
272|                seen_urls.add(u)
273|                h['_route'] = route
274|                all_hits.append(h)
275|
276|    # Route 1: collect_web platform-aware (wechat_search最优先)
277|    if platform == 'wechat':
278|        cw_hits = discover_collect_web_search(f'{name} {" ".join(kws)}', 'wechat', limit_per_platform, 30)
279|        _add(cw_hits, 'collect_web_wechat_search')
280|
281|    # Route 1b: Weibo mobile search API (weibo only, needs cookie)
282|    if platform == 'weibo':
283|        wb_hits = discover_weibo_mobile(f'{name} {" ".join(kws)}', limit_per_platform, 20)
284|        _add(wb_hits, 'weibo_mobile_api')
285|
286|    # Route 2: AnySearch
287|    as_query = f'site:{site} {name} {" ".join(kws)}' if site else f'{name} {" ".join(kws)}'
288|    as_query = re.sub(r'[/／]', ' ', as_query).strip()
289|    as_hits = discover_anysearch(as_query, limit_per_platform, 20)
290|    _add(as_hits, 'anysearch')
291|
292|    # Route 2b: Filter out off-domain URLs (anysearch may return cross-platform results)
293|    weibo_domains = ('weibo.com', 'm.weibo.cn', 'weibo.cn', 'h5.video.weibo.com')
294|    if platform == 'weibo':
295|        all_hits = [h for h in all_hits if any(d in h.get('url', '') for d in weibo_domains)]
296|    elif site:
297|        site_clean = site.replace('www.', '')
298|        all_hits = [h for h in all_hits if site_clean in h.get('url', '')]
299|
300|    # Route 3: ddgs fallback (only if still < 1 result)
301|    if len(all_hits) < 1:
302|        ddgs_hits = discover_ddgs(base_q, limit_per_platform, timeout_sec)
303|        _add(ddgs_hits, 'ddgs')
304|
305|    return all_hits[:limit_per_platform]
