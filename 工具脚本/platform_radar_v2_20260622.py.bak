def _resolve_weibo_uid(name: str, cookie_str: str) -> str:
    """Resolve weibo username to UID via s.weibo.com user search."""
    import urllib.request, urllib.parse
    UA = 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
    q = urllib.parse.quote(name)
    url = f'https://s.weibo.com/user?q={q}&Refer=weibo_user'
    try:
        req = urllib.request.Request(url, headers={
            'User-Agent': UA, 'Cookie': cookie_str,
            'Accept': 'text/html', 'Referer': 'https://weibo.com/',
        })
        resp = urllib.request.urlopen(req, timeout=15)
        raw = resp.read().decode('utf-8', 'ignore')
        # Extract UIDs from /u/NNNN links
        uids = re.findall(r'/u/(\d{8,12})', raw)
        if uids:
            # Verify first candidate via profile API
            for uid in dict.fromkeys(uids):  # dedupe preserving order
                api = f'https://weibo.com/ajax/profile/info?uid={uid}'
                req2 = urllib.request.Request(api, headers={
                    'User-Agent': UA, 'Cookie': cookie_str,
                    'Referer': f'https://weibo.com/u/{uid}',
                })
                try:
                    resp2 = urllib.request.urlopen(req2, timeout=8)
                    data = json.loads(resp2.read().decode('utf-8', 'ignore'))
                    user = data.get('data', {}).get('user', {})
                    screen_name = user.get('screen_name', '')
                    followers = user.get('followers_count', 0)
                    # Must match name and have significant following
                    if (name in screen_name or screen_name in name) and followers > 10000:
                        return uid
                except Exception:
                    continue
    except Exception:
        pass
    return ''

def discover_weibo_mobile(query: str, max_results: int = 3, timeout: int = 20) -> list[dict]:
186|    """Weibo desktop API (weibo.com/ajax) with cookie. Returns actual post URLs."""
187|    import urllib.request, urllib.parse
188|    cookie_file = Path('/root/.hermes/weibo_cookies.txt')
189|    if not cookie_file.exists():
190|        return []
191|    cookies = {}
192|    for line in cookie_file.read_text(encoding='utf-8', errors='ignore').splitlines():
193|        line = line.strip()
194|        if not line or (line.startswith('#') and not line.startswith('#HttpOnly_')):
195|            continue
196|        if line.startswith('#HttpOnly_'):
197|            line = line[10:]
198|        parts = line.split('\t')
199|        if len(parts) >= 7:
200|            cookies[parts[5]] = parts[6]
201|    if not cookies:
202|        return []
203|    cookie_str = '; '.join(f'{k}={v}' for k, v in cookies.items())
204|    # Known UIDs for watchlist accounts
205|    uid_map = {
206|        '沈逸': '5197694130', '差评君': '5617684017',
207|        '高志凯': '1727858281', '金灿荣': '1678020401',
208|    }
209|    uid = ''
210|    for name, id_ in uid_map.items():
211|        if name in query:
212|            uid = id_
213|            break
214|    if not uid:
215|        # Try extracting UID from query
216|        m = re.search(r'(\d{8,12})', query)
217|        if m:
218|            uid = m.group(1)
219|    if not uid:
220|        return []
221|    api = f'https://weibo.com/ajax/statuses/mymblog?uid={uid}&page=1&feature=0'
222|    headers = {
223|        'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
224|        'Cookie': cookie_str,
225|        'Referer': f'https://weibo.com/u/{uid}',
226|    }
227|    try:
228|        req = urllib.request.Request(api, headers=headers)
229|        resp = urllib.request.urlopen(req, timeout=timeout)
230|        raw = resp.read().decode('utf-8', 'ignore')
231|        data = json.loads(raw)
232|    except Exception:
233|        return []
234|    hits = []
235|    for post in (data.get('data', {}).get('list', [])):
236|        mid = post.get('mid', '')
237|        if not mid:
238|            continue
239|        text = post.get('text_raw', '') or re.sub(r'<[^>]+>', '', post.get('text', ''))
240|        url = f'https://m.weibo.cn/detail/{mid}'
241|        hits.append({'title': text[:120], 'url': url, 'body': text[:500]})
242|        if len(hits) >= max_results:
243|            break
244|    return hits
245|    return hits
