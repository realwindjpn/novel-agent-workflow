{"font_size": 0.4, "font_color": "#FFFFFF", "background_alpha": 0.5, "background_color": "#9C27B0", "Stroke": "none", "type": "AIsubtitle", "lang": "zh", "version": "v1.7.0.4", "body": [{"from": 0.22, "to": 3.4, "sid": 1, "location": 2, "content": "现在是美国和以色列", "music": 0.0}, {"from": 3.4, "to": 7.92, "sid": 2, "location": 2, "content": "联手对伊朗发动了侵略战争", "music": 0.0}, {"from": 7.92, "to": 9.68, "sid": 3, "location": 2, "content": "这一点至关重要", "music": 0.0}, {"from": 9.68, "to": 14.57, "sid": 4, "location": 2, "content": "美国人用谈判作幌子在欺骗伊朗", "music": 0.0}, {"from": 14.57, "to": 16.43, "sid": 5, "location": 2, "content": "特朗普总统及其政府", "music": 0.0}, {"from": 16.43, "to": 19.159, "sid": 6, "location": 2, "content": "现在是打开了一个马蜂窝", "music": 0.0}, {"from": 19.159, "to": 23.73, "sid": 7, "location": 2, "content": "他很有可能把美国拖进了跟伊朗对抗", "music": 0.0}, {"from": 23.73, "to": 26.47, "sid": 8, "location": 2, "content": "跟伊朗战争的这个泥潭之中", "music": 0.0}, {"from": 26.47, "to": 29.42, "sid": 9, "location": 2, "content": "一时半会儿他还真的拔不出来", "music": 0.0}, {"from": 29.42, "to": 36.04, "sid": 10, "location": 2, "content": "他最后很有可能把整个中东推入战争之中", "music": 0.0}, {"from": 39.56, "to": 40.34, "sid": 11, "location": 2, "content": "大家好", "music": 0.0}, {"from": 41.66, "to": 43.78, "sid": 12, "location": 2, "content": "我今天跟大家谈一谈", "music": 0.0}, {"from": 43.78, "to": 49.489, "sid": 13, "location": 2, "content": "美国和以色列正在发动的针对伊朗的侵略战争", "music": 0.0}, {"from": 49.769, "to": 52.749, "sid": 14, "location": 2, "content": "2月28号消息传来", "music": 0.0}, {"from": 52.749, "to": 55.509, "sid": 15, "location": 2, "content": "在以色列的捣鼓下", "music": 0.0}, {"from": 55.509, "to": 59.74, "sid": 16, "location": 2, "content": "以色列首先对伊朗的很多的目标", "music": 0.0}, {"from": 59.74, "to": 63.09, "sid": 17, "location": 2, "content": "发动了军事攻击", "music": 0.0}, {"from": 63.09, "to": 68.31, "sid": 18, "location": 2, "content": "随之而来的是美国也对伊朗发动了攻击", "music": 0.0}, {"from": 68.31, "to": 73.71, "sid": 19, "location": 2, "content": "所以啊现在是美国和以色列联手", "music": 0.0}, {"from": 73.71, "to": 77.12, "sid": 20, "location": 2, "content": "对伊朗发动了侵略战争", "music": 0.0}, {"from": 77.12, "to": 79.0, "sid": 21, "location": 2, "content": "这点至关重要", "music": 0.0}, {"from": 79.0, "to": 81.38, "sid": 22, "location": 2, "content": "国内有些人说哎呦", "music": 0.0}, {"from": 81.38, "to": 82.88, "sid": 23, "location": 2, "content": "美国很强大", "music": 0.0}, {"from": 82.88, "to": 85.82, "sid": 24, "location": 2, "content": "美国发动的是不是就不是侵略了", "music": 0.0}, {"from": 85.82, "to": 86.46, "sid": 25, "location": 2, "content": "然后呢", "music": 0.0}, {"from": 86.46, "to": 88.3, "sid": 26, "location": 2, "content": "美国是不是就代表正义了", "music": 0.0}, {"from": 88.3, "to": 90.34, "sid": 27, "location": 2, "content": "以色列是不是也代表正义了", "music": 0.0}, {"from": 90.34, "to": 91.19, "sid": 28, "location": 2, "content": "错", "music": 0.0}, {"from": 91.19, "to": 96.19, "sid": 29, "location": 2, "content": "这一次美国和以色列发动的针对伊朗的战争", "music": 0.0}, {"from": 96.19, "to": 98.38, "sid": 30, "location": 2, "content": "是侵略战争", "music": 0.0}, {"from": 98.38, "to": 100.32, "sid": 31, "location": 2, "content": "以色列是侵略者", "music": 0.0}, {"from": 100.32, "to": 102.18, "sid": 32, "location": 2, "content": "美国也是侵略者", "music": 0.0}, {"from": 102.18, "to": 104.22, "sid": 33, "location": 2, "content": "伊朗是受害者", "music": 0.0}, {"from": 104.22, "to": 107.0, "sid": 34, "location": 2, "content": "伊朗是被侵略的国家", "music": 0.0}, {"from": 107.0, "to": 107.92, "sid": 35, "location": 2, "content": "第二条", "music": 0.0}, {"from": 107.92, "to": 109.16, "sid": 36, "location": 2, "content": "我们看一看", "music": 0.0}, {"from": 109.16, "to": 113.35, "sid": 37, "location": 2, "content": "美国在发动对伊朗的侵略的时候", "music": 0.0}, {"from": 113.35, "to": 116.169, "sid": 38, "location": 2, "content": "正在跟伊朗进行谈判", "music": 0.0}, {"from": 116.169, "to": 118.949, "sid": 39, "location": 2, "content": "而且不断有消息弹出来", "music": 0.0}, {"from": 118.949, "to": 120.449, "sid": 40, "location": 2, "content": "一会儿弹得差不多了", "music": 0.0}, {"from": 120.449, "to": 121.629, "sid": 41, "location": 2, "content": "一会儿又不行了", "music": 0.0}, {"from": 121.629, "to": 125.65, "sid": 42, "location": 2, "content": "美国不断的在改变他的要求等等等等", "music": 0.0}, {"from": 125.65, "to": 132.24, "sid": 43, "location": 2, "content": "但是美国跟伊朗的谈判从来没有停下来啊", "music": 0.0}, {"from": 132.24, "to": 135.8, "sid": 44, "location": 2, "content": "也就是说美国的名誉何在", "music": 0.0}, {"from": 135.8, "to": 137.08, "sid": 45, "location": 2, "content": "信誉何在", "music": 0.0}, {"from": 137.08, "to": 140.11, "sid": 46, "location": 2, "content": "他利用谈判做幌子", "music": 0.0}, {"from": 140.11, "to": 142.39, "sid": 47, "location": 2, "content": "实际上是在备战", "music": 0.0}, {"from": 142.39, "to": 143.63, "sid": 48, "location": 2, "content": "与此同时", "music": 0.0}, {"from": 143.63, "to": 148.7, "sid": 49, "location": 2, "content": "他又在中东聚集了有两个航母战斗群", "music": 0.0}, {"from": 148.7, "to": 149.88, "sid": 50, "location": 2, "content": "巨大的兵力", "music": 0.0}, {"from": 149.88, "to": 152.38, "sid": 51, "location": 2, "content": "据说是在过去几十年啊", "music": 0.0}, {"from": 152.38, "to": 157.589, "sid": 52, "location": 2, "content": "美国在伊朗周边地区聚集了最大量的军事力量", "music": 0.0}, {"from": 157.589, "to": 161.77, "sid": 53, "location": 2, "content": "和各种各样的武器装备等等", "music": 0.0}, {"from": 161.77, "to": 163.13, "sid": 54, "location": 2, "content": "一方面在谈", "music": 0.0}, {"from": 163.13, "to": 167.62, "sid": 55, "location": 2, "content": "另外一方面呢就在准备对伊朗动手", "music": 0.0}, {"from": 167.62, "to": 172.36, "sid": 56, "location": 2, "content": "所以啊美国人用谈判做幌子", "music": 0.0}, {"from": 172.36, "to": 175.2, "sid": 57, "location": 2, "content": "用谈判做一个骗局", "music": 0.0}, {"from": 175.2, "to": 177.12, "sid": 58, "location": 2, "content": "在欺骗伊朗", "music": 0.0}, {"from": 177.12, "to": 178.08, "sid": 59, "location": 2, "content": "这一来的话", "music": 0.0}, {"from": 178.08, "to": 180.28, "sid": 60, "location": 2, "content": "你想想看这样的一个国家", "music": 0.0}, {"from": 180.28, "to": 181.54, "sid": 61, "location": 2, "content": "这样的一个政府", "music": 0.0}, {"from": 181.54, "to": 184.82, "sid": 62, "location": 2, "content": "他以后还有什么信誉可言", "music": 0.0}, {"from": 184.82, "to": 186.84, "sid": 63, "location": 2, "content": "另外一个我想强调的", "music": 0.0}, {"from": 186.84, "to": 187.9, "sid": 64, "location": 2, "content": "就这一次", "music": 0.0}, {"from": 187.9, "to": 191.49, "sid": 65, "location": 2, "content": "以色列和美国发动的对伊朗的侵略战争", "music": 0.0}, {"from": 191.49, "to": 195.62, "sid": 66, "location": 2, "content": "主要是以色列在捣鬼", "music": 0.0}, {"from": 195.62, "to": 201.03, "sid": 67, "location": 2, "content": "以色列呢去年发动了对伊朗的战争", "music": 0.0}, {"from": 201.03, "to": 203.29, "sid": 68, "location": 2, "content": "最后呢惹了一身骚", "music": 0.0}, {"from": 203.29, "to": 205.47, "sid": 69, "location": 2, "content": "因为自己发现了哎呦", "music": 0.0}, {"from": 205.47, "to": 209.69, "sid": 70, "location": 2, "content": "他奉为真理的铁穹防空系统", "music": 0.0}, {"from": 209.69, "to": 213.25, "sid": 71, "location": 2, "content": "最后基本上被伊朗砸了个稀巴烂", "music": 0.0}, {"from": 213.25, "to": 218.21, "sid": 72, "location": 2, "content": "而且呢根本没有像以色列以前所吹嘘的", "music": 0.0}, {"from": 218.21, "to": 219.86, "sid": 73, "location": 2, "content": "刀枪不入", "music": 0.0}, {"from": 219.86, "to": 224.4, "sid": 74, "location": 2, "content": "最后还是靠美国帮了以色列一把", "music": 0.0}, {"from": 224.4, "to": 230.68, "sid": 75, "location": 2, "content": "然后呢对于伊朗进行了重磅武器的轰炸", "music": 0.0}, {"from": 230.68, "to": 235.86, "sid": 76, "location": 2, "content": "才把上一次的那个冲突啊暂时告一段落", "music": 0.0}, {"from": 235.86, "to": 240.84, "sid": 77, "location": 2, "content": "所以这一次我觉得以色列他改变了他的想法", "music": 0.0}, {"from": 241.16, "to": 247.17, "sid": 78, "location": 2, "content": "他这次想说服美国率先对伊朗发动攻击", "music": 0.0}, {"from": 247.17, "to": 250.73, "sid": 79, "location": 2, "content": "但是大家知道特朗普也不是一盏省油的灯啊", "music": 0.0}, {"from": 250.73, "to": 253.36, "sid": 80, "location": 2, "content": "他不愿意做这样的", "music": 0.0}, {"from": 253.36, "to": 256.84, "sid": 81, "location": 2, "content": "很难有收收益哦的事情", "music": 0.0}, {"from": 256.84, "to": 259.04, "sid": 82, "location": 2, "content": "所以后来的消息是说", "music": 0.0}, {"from": 259.04, "to": 262.0, "sid": 83, "location": 2, "content": "特朗普希望以色列要动手", "music": 0.0}, {"from": 262.0, "to": 263.6, "sid": 84, "location": 2, "content": "你以色列先动手", "music": 0.0}, {"from": 263.6, "to": 265.94, "sid": 85, "location": 2, "content": "我随后再说", "music": 0.0}, {"from": 265.94, "to": 267.28, "sid": 86, "location": 2, "content": "这一来的话", "music": 0.0}, {"from": 267.28, "to": 269.02, "sid": 87, "location": 2, "content": "最后是以色列说", "music": 0.0}, {"from": 269.02, "to": 271.08, "sid": 88, "location": 2, "content": "那由我来先来动手", "music": 0.0}, {"from": 271.08, "to": 273.2, "sid": 89, "location": 2, "content": "但是你美国必须跟进啊", "music": 0.0}, {"from": 273.2, "to": 275.01, "sid": 90, "location": 2, "content": "比我先动手了以后", "music": 0.0}, {"from": 275.01, "to": 276.49, "sid": 91, "location": 2, "content": "你就撂摊子了", "music": 0.0}, {"from": 276.49, "to": 277.75, "sid": 92, "location": 2, "content": "那也不行", "music": 0.0}, {"from": 277.75, "to": 282.67, "sid": 93, "location": 2, "content": "所以最后以以色列首先发动对伊朗的军事进攻", "music": 0.0}, {"from": 282.67, "to": 284.45, "sid": 94, "location": 2, "content": "然后美国紧接", "music": 0.0}, {"from": 284.45, "to": 288.99, "sid": 95, "location": 2, "content": "随后这是以色列和美国谈出的一个妥协方案", "music": 0.0}, {"from": 288.99, "to": 292.95, "sid": 96, "location": 2, "content": "并不是以色列原来的最优先的方案", "music": 0.0}, {"from": 292.95, "to": 294.789, "sid": 97, "location": 2, "content": "那伊朗该怎么办呢", "music": 0.0}, {"from": 294.789, "to": 297.449, "sid": 98, "location": 2, "content": "伊朗现在说既然这样的话", "music": 0.0}, {"from": 297.449, "to": 301.56, "sid": 99, "location": 2, "content": "那我就发动毫无顾忌的攻击", "music": 0.0}, {"from": 301.56, "to": 302.46, "sid": 100, "location": 2, "content": "据说啊", "music": 0.0}, {"from": 302.46, "to": 306.55, "sid": 101, "location": 2, "content": "伊朗已经给在中东地区的四个国家的", "music": 0.0}, {"from": 306.55, "to": 308.51, "sid": 102, "location": 2, "content": "美国基地发动了攻击", "music": 0.0}, {"from": 308.51, "to": 312.03, "sid": 103, "location": 2, "content": "包括比如说呃卡塔尔", "music": 0.0}, {"from": 312.03, "to": 313.09, "sid": 104, "location": 2, "content": "阿联酋", "music": 0.0}, {"from": 313.09, "to": 314.21, "sid": 105, "location": 2, "content": "巴林", "music": 0.0}, {"from": 314.21, "to": 316.65, "sid": 106, "location": 2, "content": "还有科威特", "music": 0.0}, {"from": 317.08, "to": 318.38, "sid": 107, "location": 2, "content": "这样一来的话", "music": 0.0}, {"from": 318.38, "to": 320.6, "sid": 108, "location": 2, "content": "美军现在也吃紧啊", "music": 0.0}, {"from": 320.6, "to": 325.23, "sid": 109, "location": 2, "content": "另外伊朗会不会下一轮对于美国在红海", "music": 0.0}, {"from": 325.23, "to": 326.63, "sid": 110, "location": 2, "content": "在地中海", "music": 0.0}, {"from": 326.63, "to": 330.96, "sid": 111, "location": 2, "content": "在波斯湾里边的军舰发动攻击", "music": 0.0}, {"from": 330.96, "to": 332.12, "sid": 112, "location": 2, "content": "特朗普总统说", "music": 0.0}, {"from": 332.12, "to": 335.0, "sid": 113, "location": 2, "content": "我现在要消灭伊朗所有的海军舰", "music": 0.0}, {"from": 335.0, "to": 339.72, "sid": 114, "location": 2, "content": "只要摧毁伊朗所有的导弹和弹道导弹", "music": 0.0}, {"from": 339.72, "to": 345.35, "sid": 115, "location": 2, "content": "另外彻底的剥夺伊朗发展原子弹的能力", "music": 0.0}, {"from": 345.35, "to": 346.83, "sid": 116, "location": 2, "content": "所以现在看来的话", "music": 0.0}, {"from": 346.83, "to": 349.94, "sid": 117, "location": 2, "content": "伊朗和美国和以色列", "music": 0.0}, {"from": 349.94, "to": 352.88, "sid": 118, "location": 2, "content": "已经到了水火不相容的地步", "music": 0.0}, {"from": 352.88, "to": 356.82, "sid": 119, "location": 2, "content": "那么最终这场战争到底会以什么方式而告终呢", "music": 0.0}, {"from": 356.82, "to": 358.4, "sid": 120, "location": 2, "content": "现在看不清楚", "music": 0.0}, {"from": 358.4, "to": 361.06, "sid": 121, "location": 2, "content": "但是以色列现在就是想做这个事", "music": 0.0}, {"from": 361.06, "to": 364.45, "sid": 122, "location": 2, "content": "他甚至说遇到这样的情况", "music": 0.0}, {"from": 364.45, "to": 366.45, "sid": 123, "location": 2, "content": "暗杀是最有效的方法", "music": 0.0}, {"from": 366.45, "to": 368.21, "sid": 124, "location": 2, "content": "是成本最低的方法", "music": 0.0}, {"from": 368.21, "to": 371.83, "sid": 125, "location": 2, "content": "所以以色列现在是通过斩首行动", "music": 0.0}, {"from": 371.83, "to": 375.31, "sid": 126, "location": 2, "content": "要推翻伊朗的政府", "music": 0.0}, {"from": 375.31, "to": 377.37, "sid": 127, "location": 2, "content": "美国现在也紧跟其后啊", "music": 0.0}, {"from": 377.37, "to": 382.72, "sid": 128, "location": 2, "content": "他也是说我现在要跟以色列奥共同行动", "music": 0.0}, {"from": 382.72, "to": 387.69, "sid": 129, "location": 2, "content": "来造成伊朗的权力更替", "music": 0.0}, {"from": 387.69, "to": 389.81, "sid": 130, "location": 2, "content": "改变伊朗的颜色", "music": 0.0}, {"from": 389.81, "to": 391.37, "sid": 131, "location": 2, "content": "我想跟大家说", "music": 0.0}, {"from": 391.37, "to": 394.73, "sid": 132, "location": 2, "content": "伊朗人口接近一个亿呀", "music": 0.0}, {"from": 394.73, "to": 398.34, "sid": 133, "location": 2, "content": "而且国土面积非常的庞大", "music": 0.0}, {"from": 398.34, "to": 400.9, "sid": 134, "location": 2, "content": "伊朗的地形非常的复杂", "music": 0.0}, {"from": 400.9, "to": 402.44, "sid": 135, "location": 2, "content": "有崇山峻岭", "music": 0.0}, {"from": 402.44, "to": 403.87, "sid": 136, "location": 2, "content": "有沙漠地带", "music": 0.0}, {"from": 404.96, "to": 409.84, "sid": 137, "location": 2, "content": "这个国家你要去用军事手段去征服他的话", "music": 0.0}, {"from": 409.84, "to": 412.659, "sid": 138, "location": 2, "content": "一时半会儿还真的不好征服", "music": 0.0}, {"from": 412.659, "to": 413.899, "sid": 139, "location": 2, "content": "所以我觉得啊", "music": 0.0}, {"from": 413.899, "to": 418.7, "sid": 140, "location": 2, "content": "特朗普总统及其政府现在是打开了一个马蜂窝", "music": 0.0}, {"from": 418.7, "to": 421.8, "sid": 141, "location": 2, "content": "特朗普老是会算小账了", "music": 0.0}, {"from": 421.8, "to": 424.0, "sid": 142, "location": 2, "content": "他想速战速决", "music": 0.0}, {"from": 424.0, "to": 426.9, "sid": 143, "location": 2, "content": "然后呢以英雄", "music": 0.0}, {"from": 427.86, "to": 429.62, "sid": 144, "location": 2, "content": "呈现在世界上", "music": 0.0}, {"from": 429.62, "to": 431.72, "sid": 145, "location": 2, "content": "呈现在美国人民之上", "music": 0.0}, {"from": 431.72, "to": 436.159, "sid": 146, "location": 2, "content": "但是这个十有八九它很难实现", "music": 0.0}, {"from": 436.159, "to": 440.719, "sid": 147, "location": 2, "content": "他很有可能把美国拖进了跟伊朗对抗", "music": 0.0}, {"from": 440.719, "to": 444.01, "sid": 148, "location": 2, "content": "跟伊朗战争的这个泥潭之中", "music": 0.0}, {"from": 444.01, "to": 449.789, "sid": 149, "location": 2, "content": "美国在一头扎进中东的战争的泥潭", "music": 0.0}, {"from": 449.789, "to": 451.009, "sid": 150, "location": 2, "content": "大家听我说", "music": 0.0}, {"from": 451.009, "to": 453.789, "sid": 151, "location": 2, "content": "一时半会儿他还真的拔不出来", "music": 0.0}, {"from": 454.829, "to": 460.17, "sid": 152, "location": 2, "content": "因为以色列和美国所发动的针对伊朗的战争", "music": 0.0}, {"from": 460.17, "to": 466.169, "sid": 153, "location": 2, "content": "他最后很有可能把整个中东退入战争之中", "music": 0.0}, {"from": 466.169, "to": 467.389, "sid": 154, "location": 2, "content": "因为你看一看", "music": 0.0}, {"from": 467.389, "to": 473.51, "sid": 155, "location": 2, "content": "在中东有很多国家都有势力强大的什叶派", "music": 0.0}, {"from": 473.51, "to": 477.56, "sid": 156, "location": 2, "content": "他们都是跟伊朗有千丝万缕的联系", "music": 0.0}, {"from": 477.56, "to": 479.56, "sid": 157, "location": 2, "content": "包括侯塞武装啊等等", "music": 0.0}, {"from": 479.56, "to": 481.16, "sid": 158, "location": 2, "content": "他们现在都已经发誓", "music": 0.0}, {"from": 481.16, "to": 484.4, "sid": 159, "location": 2, "content": "一定要把战火烧到以色列", "music": 0.0}, {"from": 484.4, "to": 489.24, "sid": 160, "location": 2, "content": "一定要摧毁在中东地区的美军的基地", "music": 0.0}, {"from": 489.24, "to": 492.31, "sid": 161, "location": 2, "content": "这一来的话大家要做好准备哦", "music": 0.0}, {"from": 492.31, "to": 495.77, "sid": 162, "location": 2, "content": "美国和以色列发动的针对伊朗的侵略战争", "music": 0.0}, {"from": 495.77, "to": 501.22, "sid": 163, "location": 2, "content": "有可能把整个中东地区推入战争之中", "music": 0.0}, {"from": 501.22, "to": 506.48, "sid": 164, "location": 2, "content": "下一步伊朗很有可能会封锁霍尔木兹海峡", "music": 0.0}, {"from": 506.48, "to": 510.89, "sid": 165, "location": 2, "content": "这一来的话就会使得比如说沙特阿拉伯啊", "music": 0.0}, {"from": 510.89, "to": 512.17, "sid": 166, "location": 2, "content": "卡塔尔啊", "music": 0.0}, {"from": 512.17, "to": 513.17, "sid": 167, "location": 2, "content": "科威特啊", "music": 0.0}, {"from": 513.17, "to": 518.83, "sid": 168, "location": 2, "content": "伊拉克啊等等国家的石油和天然气啊给停住", "music": 0.0}, {"from": 518.83, "to": 521.229, "sid": 169, "location": 2, "content": "运不出霍尔木兹海峡", "music": 0.0}, {"from": 521.229, "to": 522.329, "sid": 170, "location": 2, "content": "无法再向", "music": 0.0}, {"from": 522.329, "to": 526.81, "sid": 171, "location": 2, "content": "比如说亚洲其他地方或者欧洲或者美洲运过去", "music": 0.0}, {"from": 526.81, "to": 531.11, "sid": 172, "location": 2, "content": "这将造成世界能源的崩盘", "music": 0.0}, {"from": 531.11, "to": 535.84, "sid": 173, "location": 2, "content": "那石油和天然气价格可能一冲上天", "music": 0.0}, {"from": 535.84, "to": 540.54, "sid": 174, "location": 2, "content": "而且呢它会拖累全世界的经济发展", "music": 0.0}, {"from": 540.54, "to": 545.81, "sid": 175, "location": 2, "content": "另外它很有可能会造成全球经济的大波动", "music": 0.0}, {"from": 545.81, "to": 547.839, "sid": 176, "location": 2, "content": "金融的大波动", "music": 0.0}, {"from": 547.839, "to": 550.879, "sid": 177, "location": 2, "content": "他只知道我过去已经说了很长一段时间了", "music": 0.0}, {"from": 550.879, "to": 555.22, "sid": 178, "location": 2, "content": "我认为在12个月到18个月期间内", "music": 0.0}, {"from": 555.22, "to": 561.54, "sid": 179, "location": 2, "content": "美国将爆发重大的甚至是前所未有的金融危机", "music": 0.0}, {"from": 561.54, "to": 564.39, "sid": 180, "location": 2, "content": "那么现在战争已经开始", "music": 0.0}, {"from": 564.39, "to": 566.37, "sid": 181, "location": 2, "content": "美国和以色列作为一方", "music": 0.0}, {"from": 566.37, "to": 570.47, "sid": 182, "location": 2, "content": "正要消灭伊朗这样的一个国家及其政权", "music": 0.0}, {"from": 570.47, "to": 575.75, "sid": 183, "location": 2, "content": "他会不会把整个中东地区推入战火之中", "music": 0.0}, {"from": 575.75, "to": 579.66, "sid": 184, "location": 2, "content": "伊朗28号多次表态", "music": 0.0}, {"from": 579.66, "to": 583.819, "sid": 185, "location": 2, "content": "他拥有前所未有的军事力量", "music": 0.0}, {"from": 583.819, "to": 586.239, "sid": 186, "location": 2, "content": "他能够对于侵略者", "music": 0.0}, {"from": 586.239, "to": 590.46, "sid": 187, "location": 2, "content": "这次就是包括美国和以色列予以痛击", "music": 0.0}, {"from": 590.46, "to": 594.3, "sid": 188, "location": 2, "content": "那么他到底有什么样的拿手好戏呢", "music": 0.0}, {"from": 594.3, "to": 597.85, "sid": 189, "location": 2, "content": "他还有什么样的杀手锏呢", "music": 0.0}, {"from": 597.85, "to": 598.77, "sid": 190, "location": 2, "content": "当然了", "music": 0.0}, {"from": 598.77, "to": 602.41, "sid": 191, "location": 2, "content": "美国已经把他最精锐的部队", "music": 0.0}, {"from": 602.41, "to": 608.72, "sid": 192, "location": 2, "content": "最先进的武器都押宝押在要打败伊朗之上", "music": 0.0}, {"from": 608.72, "to": 611.55, "sid": 193, "location": 2, "content": "这一来的话我担心啊", "music": 0.0}, {"from": 611.55, "to": 614.35, "sid": 194, "location": 2, "content": "美国和以色列发动的这次针对伊朗的战争", "music": 0.0}, {"from": 614.35, "to": 617.5, "sid": 195, "location": 2, "content": "绝对不可能说四天就结束战争了", "music": 0.0}, {"from": 617.5, "to": 620.7, "sid": 196, "location": 2, "content": "绝对不可能像特朗普所想象的哎", "music": 0.0}, {"from": 620.7, "to": 623.76, "sid": 197, "location": 2, "content": "我再打一个短平快把他给打趴下", "music": 0.0}, {"from": 623.76, "to": 625.08, "sid": 198, "location": 2, "content": "然后我全胜", "music": 0.0}, {"from": 625.08, "to": 626.11, "sid": 199, "location": 2, "content": "伊朗全败", "music": 0.0}, {"from": 626.11, "to": 627.39, "sid": 200, "location": 2, "content": "伊朗人民欢呼", "music": 0.0}, {"from": 627.39, "to": 629.29, "sid": 201, "location": 2, "content": "我把我当作是英雄", "music": 0.0}, {"from": 629.29, "to": 630.69, "sid": 202, "location": 2, "content": "凯旋而归", "music": 0.0}, {"from": 630.69, "to": 632.86, "sid": 203, "location": 2, "content": "不可能的", "music": 0.0}, {"from": 633.22, "to": 636.3, "sid": 204, "location": 2, "content": "伊朗存世五六千年了", "music": 0.0}, {"from": 636.3, "to": 640.56, "sid": 205, "location": 2, "content": "他在他的历史上面临过各种各样的挑战啊", "music": 0.0}, {"from": 640.56, "to": 642.56, "sid": 206, "location": 2, "content": "他也有好几次被灭国", "music": 0.0}, {"from": 642.56, "to": 646.17, "sid": 207, "location": 2, "content": "然后又崛起等等又强大", "music": 0.0}, {"from": 646.17, "to": 650.91, "sid": 208, "location": 2, "content": "所以呢伊朗是一个非常非常复杂的民族", "music": 0.0}, {"from": 650.91, "to": 656.89, "sid": 209, "location": 2, "content": "他有非常深奥的自己的哲学和处世态度", "music": 0.0}, {"from": 656.89, "to": 661.23, "sid": 210, "location": 2, "content": "我认为啊伊朗这次也是做好了最坏的打算", "music": 0.0}, {"from": 661.55, "to": 665.12, "sid": 211, "location": 2, "content": "他一定会拿出全国的力量", "music": 0.0}, {"from": 665.12, "to": 668.88, "sid": 212, "location": 2, "content": "来捍卫伊朗的主权与领土完整", "music": 0.0}, {"from": 668.88, "to": 671.65, "sid": 213, "location": 2, "content": "捍卫整个伊朗民族和文明", "music": 0.0}, {"from": 671.65, "to": 675.73, "sid": 214, "location": 2, "content": "包括过去的波斯文明的继续的生存", "music": 0.0}, {"from": 675.73, "to": 679.7, "sid": 215, "location": 2, "content": "所以这场战争既然已经爆发", "music": 0.0}, {"from": 679.7, "to": 682.62, "sid": 216, "location": 2, "content": "一时半会儿我觉得停不下来", "music": 0.0}, {"from": 682.62, "to": 684.54, "sid": 217, "location": 2, "content": "然后呢我们都要做好准备", "music": 0.0}, {"from": 684.54, "to": 687.72, "sid": 218, "location": 2, "content": "因为这个战场战争虽然在中东发生", "music": 0.0}, {"from": 687.72, "to": 691.68, "sid": 219, "location": 2, "content": "但是对于我们中国是有直接的关联啊", "music": 0.0}, {"from": 691.68, "to": 695.17, "sid": 220, "location": 2, "content": "因为它会直接影响到我们的能源安全", "music": 0.0}, {"from": 695.17, "to": 697.87, "sid": 221, "location": 2, "content": "它会影响到整个世界的经济", "music": 0.0}, {"from": 697.87, "to": 703.2, "sid": 222, "location": 2, "content": "甚至有可能造成世界金融的危机的大爆发", "music": 0.0}, {"from": 703.2, "to": 708.14, "sid": 223, "location": 2, "content": "甚至会不会跟打了4年之久的乌克兰战争哦", "music": 0.0}, {"from": 708.14, "to": 713.14, "sid": 224, "location": 2, "content": "两个风马牛不相及的两场战争在交汇在一块呢", "music": 0.0}, {"from": 713.14, "to": 717.23, "sid": 225, "location": 2, "content": "会不会在给整个世界的和平与安全", "music": 0.0}, {"from": 717.23, "to": 720.49, "sid": 226, "location": 2, "content": "构成致命的打击呢", "music": 0.0}, {"from": 720.57, "to": 722.81, "sid": 227, "location": 2, "content": "我们一定要站稳脚跟", "music": 0.0}, {"from": 723.89, "to": 725.89, "sid": 228, "location": 2, "content": "稳步前进", "music": 0.0}, {"from": 726.4, "to": 730.46, "sid": 229, "location": 2, "content": "此时此刻是我们最需要智慧", "music": 0.0}, {"from": 730.46, "to": 731.5, "sid": 230, "location": 2, "content": "勇气", "music": 0.0}, {"from": 731.5, "to": 735.46, "sid": 231, "location": 2, "content": "远见和实力的时候", "music": 0.0}, {"from": 735.78, "to": 738.76, "sid": 232, "location": 2, "content": "中国必须站稳脚跟", "music": 0.0}, {"from": 739.2, "to": 740.64, "sid": 233, "location": 2, "content": "稳步前进", "music": 0.0}, {"from": 740.64, "to": 743.52, "sid": 234, "location": 2, "content": "一方面捍卫我们自己的主权与领土完整", "music": 0.0}, {"from": 743.52, "to": 746.37, "sid": 235, "location": 2, "content": "和中国人民的正当的权益", "music": 0.0}, {"from": 746.37, "to": 747.75, "sid": 236, "location": 2, "content": "另外一方面", "music": 0.0}, {"from": 747.75, "to": 752.13, "sid": 237, "location": 2, "content": "一定要为捍卫世界各国的主权和领土完整", "music": 0.0}, {"from": 752.13, "to": 754.04, "sid": 238, "location": 2, "content": "捍卫世界的和平", "music": 0.0}, {"from": 754.36, "to": 756.32, "sid": 239, "location": 2, "content": "做出我们应有的贡献", "music": 0.0}, {"from": 758.12, "to": 759.28, "sid": 240, "location": 2, "content": "谢谢大家", "music": 0.0}]}