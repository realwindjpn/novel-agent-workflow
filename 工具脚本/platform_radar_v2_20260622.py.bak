137|def discover_collect_web_search(query: str, platform: str, max_items: int = 3, timeout: int = 30) -> list[dict]:
138|    """collect_web --source <platform>_search / anysearch 路由。"""
139|    source_map = {
140|        'wechat': 'wechat_search',
141|        'bilibili': 'anysearch',   # bili API需cookie，先用anysearch site:
142|        'weibo': 'anysearch',      # weibo同理
143|        'zhihu': 'anysearch',
144|    }
145|    source = source_map.get(platform, 'anysearch')
146|    url_arg = query  # collect_web --url 接受query字符串
147|    if platform in ('bilibili', 'weibo', 'zhihu'):
148|        site_map = {'bilibili': 'bilibili.com', 'weibo': 'weibo.com', 'zhihu': 'zhihu.com'}
149|        url_arg = f'site:{site_map[platform]} {query}'
150|    cmd = [sys.executable, str(COLLECT_WEB), '--source', source, '--url', url_arg, '--max-items', str(max_items)]
151|    rc, out, err = run_cmd(cmd, timeout=timeout)
152|    if rc != 0 or not out.strip():
153|        return []
154|    try:
155|        data = json.loads(out.strip())
156|    except json.JSONDecodeError:
157|        return []
158|    hits = []
159|    for item in data.get('data', []):
160|        url = item.get('url', '')
161|        title = item.get('title', item.get('source', ''))
162|        body = item.get('body', item.get('excerpt', ''))
163|        if url:
164|            hits.append({'title': title or '', 'url': url, 'body': body or ''})
165|    return hits
