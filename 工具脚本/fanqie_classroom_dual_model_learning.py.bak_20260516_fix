def log(msg: str):
    ts = time.strftime('%F %T')
    line = f'[{ts}] {msg}\n'
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open('a', encoding='utf-8') as f: f.write(line)
    print(line, end='', flush=True)


def save_state(**kw):
    cur = {}
    if STATE.exists():
        try: cur = json.loads(STATE.read_text(encoding='utf-8'))
        except Exception: cur = {}
    cur.update(kw, updated_at=time.strftime('%F %T'))
    STATE.write_text(json.dumps(cur, ensure_ascii=False, indent=2), encoding='utf-8')


def fetch_article(url: str) -> str:
    # 优先浏览器可抓内容；requests兜底读取SPA HTML，再用简单标签清理。
    try:
        cmd = [
            'python3','-c',
            "from hermes_tools import mcp_research_materials_crawl_url_markdown as c; import sys,json; print(json.dumps(c(url=sys.argv[1], max_chars=50000), ensure_ascii=False))",
            url
        ]
    except Exception:
        cmd = []
    # 实际 hermes_tools 未必暴露mcp，故直接用 agent-browser 稳定抽 article。
    try:
        subprocess.run(['agent-browser','--session-name','fanqie_classroom','open',url], check=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=90)
        time.sleep(2)
        js = "(() => document.querySelector('article')?.innerText || document.body.innerText)()"
        out = subprocess.check_output(['agent-browser','--session-name','fanqie_classroom','eval',js], text=True, timeout=90)
        text = out.strip()
        if text.startswith('"'):
            try: text = json.loads(text)
            except Exception: pass
        if len(text) > 500:
            return text
    except Exception as e:
        log(f'browser_fetch_failed {type(e).__name__}: {e}')
    if requests:
        r = requests.get(url, timeout=30, headers={'User-Agent':'Mozilla/5.0'})
        return re.sub('<[^>]+>', '\n', r.text)
    req=Request(url, headers={'User-Agent':'Mozilla/5.0'})
    return urlopen(req, timeout=30).read().decode('utf-8','ignore')


def openai_chat(base_url: str, api_key: str, model: str, messages: list[dict], timeout=240) -> tuple[str, str]:
    import requests
    url = base_url.rstrip('/') + '/chat/completions'
    payload = {'model': model, 'messages': messages, 'temperature': 0.25}
    r = requests.post(url, headers={'Authorization': f'Bearer {api_key}', 'Content-Type':'application/json'}, json=payload, timeout=timeout)
    r.raise_for_status()
    data = r.json()
    returned = data.get('model') or model
    text = data['choices'][0]['message']['content']
    return text, returned


