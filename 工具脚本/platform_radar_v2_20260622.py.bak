112|def discover_anysearch(query: str, max_results: int = 3, timeout: int = 20) -> list[dict]:
113|    """AnySearch CLI — 本地API, ~1-3s, 最稳定。"""
114|    if not ANYSEARCH_CLI.exists():
115|        return []
116|    rc, out, err = run_cmd(
117|        [sys.executable, str(ANYSEARCH_CLI), 'search', query, '--max_results', str(max_results)],
118|        timeout=timeout,
119|    )
120|    if rc != 0 or not out.strip():
121|        return []
122|    hits = []
123|    # parse CLI text output: each result has ### N. title + - **URL**: ... + - > excerpt
124|    blocks = re.split(r'### \d+\.', out)
125|    for blk in blocks[1:]:
126|        lines = blk.strip().splitlines()
127|        title = lines[0].strip() if lines else ''
128|        url_m = re.search(r'\*\*URL\*\*:\s*(\S+)', blk)
129|        url = url_m.group(1) if url_m else ''
130|        body_lines = [l.lstrip('- > ').strip() for l in lines if l.strip().startswith('- >')]
131|        body = ' '.join(body_lines)[:300]
132|        if url:
133|            hits.append({'title': title, 'url': url, 'body': body})
134|    return hits
135|
